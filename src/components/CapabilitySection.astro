---
/** "What {platform} does" — the six modules, in one of three presentations.
 *
 *  Which one is a content decision (`capabilityLayout` on the platform entry),
 *  not a branch on identity. Section ORDER is identical across all four pages;
 *  only this block's internal arrangement varies, which is what keeps the four
 *  reading as a family rather than as one template repeated.
 *
 *  All three render the same six modules from the same data. Nothing is hidden
 *  from a crawler in any of them — the tabs variant ships every panel in the
 *  HTML and only toggles `hidden` after hydration. */
import type { Module } from '../content/platform-detail-fixed';
import type { CapabilityLayout } from '../content/platforms';

interface Props {
  layout: CapabilityLayout;
  modules: Module[];
  name: string;
  id?: string;
}
const { layout, modules, name, id = 'capabilities' } = Astro.props;
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<div class={`cap cap-${layout}`} id={id}>
  {
    layout === 'bento' && (
      <div class="bento" data-tilt>
        {/* data-reveal sits on the styled element itself. Passing a scoped
            class to <Reveal> renders a div WITHOUT this component's
            data-astro-cid, so the scoped rule never matches — measured:
            grid-column resolved to `auto` instead of `span 2`. */}
        {modules.map((m, i) => (
          <article
            data-reveal
            style={`--i: ${Math.min(i, 3)};`}
            class={`bento-cell card hov p-6 flex flex-col gap-2 ${i === 0 ? 'bento-lead' : ''}`}
          >
            <h3 class={i === 0 ? 't-h3' : 't-h4'}>{m.title}</h3>
            <p class="t-sm">{m.body}</p>
          </article>
        ))}
      </div>
    )
  }

  {
    layout === 'tabs' && (
      <div class="tabs">
        <div role="tablist" aria-label={`What ${name} does`} class="tablist">
          {modules.map((m, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${slugify(m.title)}`}
              aria-controls={`panel-${slugify(m.title)}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="tab"
            >
              {m.title}
            </button>
          ))}
          {/* The sliding indicator. Empty and aria-hidden: it marks the
              selection, it does not announce it — aria-selected already does
              that. Zero-width and invisible until initIndicator measures a
              tab, so JS off leaves the per-tab border doing the marking. */}
          <span class="p-ind" aria-hidden="true" />
        </div>
        {/* No `hidden` in the SSR. With JS off every panel renders, stacked and
            fully readable — nothing is unreachable. The armed root hides all but
            the first before paint, and once initTabs sets data-ready it manages
            `hidden` itself. So: no flash, and no content stranded. */}
        {modules.map((m, i) => (
          <div
            role="tabpanel"
            id={`panel-${slugify(m.title)}`}
            aria-labelledby={`tab-${slugify(m.title)}`}
            tabindex="0"
            class="panel"
          >
            <h3 class="t-h4">{m.title}</h3>
            <p class="t-sm mt-2">{m.body}</p>
          </div>
        ))}
      </div>
    )
  }

  {
    layout === 'showcase' && (
      /* Sticky showcase. The pinned half is DECORATION ONLY — a step counter
         and a rail marker, both aria-hidden. It deliberately does not echo the
         module titles: duplicating them would make a screen reader read every
         title twice, and would put a copy of real content behind an opacity
         swap, which §11 forbids.

         So the reading column is the whole content, in document order, at full
         opacity. JS off means --step is never written, the counter sits at 01
         and the marker at the top, and all six modules render exactly as they
         do now. Nothing is a step that has to be reached. */
      <div class="show" data-showcase style={`--n: ${modules.length};`}>
        <div class="show-pin" aria-hidden="true">
          <p class="show-count mono m-0" />
          <div class="show-rail">
            <span class="show-mark" />
          </div>
          <p class="show-total mono t-cap m-0">/ {String(modules.length).padStart(2, '0')}</p>
        </div>

        <ol class="show-steps list-none m-0 p-0">
          {modules.map((m, i) => (
            <li class="show-step" data-step style={`--s: ${i};`}>
              <h3 class="t-h3">{m.title}</h3>
              <p class="t-sm mt-3">{m.body}</p>
            </li>
          ))}
        </ol>
      </div>
    )
  }

  {
    layout === 'alternating' && (
      <ol class="alt list-none m-0 p-0">
        {modules.map((m, i) => (
          <li class="alt-row" data-reveal style={`--i: ${Math.min(i, 3)};`}>
            <span class="alt-n mono t-cap" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="alt-body">
              <h3 class="t-h4">{m.title}</h3>
              <p class="t-sm mt-2">{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    )
  }
</div>

<style>
  /* ── Bento: uneven spans, lead tile first ─────────────────────────────── */
  .bento {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  /* The cell IS the card — no wrapper, so the scoped rule lands. */
  .bento-cell {
    height: 100%;
  }
  @media (min-width: 700px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* One tile carries more weight, so the grid is not six equal boxes. */
    .bento-lead {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  /* ── Tabs ─────────────────────────────────────────────────────────────── */
  .tablist {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-hairline);
  }
  .tab {
    font: inherit;
    font-size: var(--text-body-sm);
    font-weight: 450;
    color: var(--color-body);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.75rem 0.875rem;
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--dur-micro) var(--ease-entrance);
  }
  .tab:hover {
    color: var(--color-ink);
  }
  .tab[aria-selected='true'] {
    color: var(--color-ink);
    font-weight: 600;
    border-bottom-color: var(--page-accent);
  }
  /* Pre-JS: armed root shows only the first panel, before paint. Once
     initTabs adds data-ready it owns visibility via `hidden`. JS off → the
     attribute never appears → all six panels render. */
  :global(html[data-reveal-ready]) .tabs:not([data-ready]) .panel:not(:first-of-type) {
    display: none;
  }
  .panel {
    padding-top: 1.75rem;
    max-width: var(--prose-max-width);
    animation: panel-in var(--dur-micro) var(--ease-entrance) both;
  }
  /* Crossfade only. No height animation — the panels differ in length and
     animating that produces a jump on every switch. */
  @keyframes panel-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ── Sliding indicator ────────────────────────────────────────────────────
     Lives here rather than in platform.css because the override below has to
     beat this component's own `.tab[aria-selected='true']` rule — and Astro
     scoped styles are unlayered, so a layered file cannot do it at any
     specificity. Measured: with the rule in platform.css both markers painted.

     Progressive enhancement, in order:
       no JS  → the per-tab bottom border marks the selection, as built
       JS     → initIndicator sets data-indicator, the per-tab border goes
                transparent and this one bar takes over and slides
     The tabs' ARIA, roving tabindex and keyboard handling are untouched. */
  .p-ind {
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: var(--ind-w, 0);
    background: var(--page-accent);
    transform: translate(var(--ind-x, 0), calc(var(--ind-y, 0px) - 2px));
    opacity: 0;
    pointer-events: none;
  }
  .tablist[data-indicator] .p-ind {
    opacity: 1;
    transition:
      transform var(--dur-micro) var(--ease-entrance),
      width var(--dur-micro) var(--ease-entrance);
  }
  .tablist[data-indicator] .tab[aria-selected='true'] {
    border-bottom-color: transparent;
  }

  /* ── Sticky showcase ──────────────────────────────────────────────────────
     One column pins, the other scrolls. `--step` comes from initShowcase; the
     counter is drawn from it with a CSS counter, so the number is generated
     rather than being six spans that take turns being visible. */
  .show {
    display: grid;
    gap: 2.5rem;
  }
  .show-steps {
    display: flex;
    flex-direction: column;
  }
  .show-step {
    padding-block: 2rem;
    border-top: 1px solid var(--color-hairline);
    max-width: var(--prose-max-width);
  }
  .show-step:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .show-pin {
    display: none;
  }

  @media (min-width: 1024px) {
    .show {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 4rem;
    }
    .show-pin {
      display: flex;
      align-items: center;
      gap: 1rem;
      position: sticky;
      /* Clear of the 68px main nav and the platform sub-nav. */
      top: calc(68px + var(--subnav-h) + 3rem);
      align-self: start;
      height: 4rem;
    }
    /* Steps get room to be scrolled past, so a step is genuinely the thing in
       the middle of the viewport when the observer picks it. */
    .show-step {
      padding-block: 3.5rem;
    }
  }

  .show-count {
    font-size: var(--text-mono-lg);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    counter-reset: show-s calc(var(--step, 0) + 1);
  }
  .show-count::after {
    content: counter(show-s, decimal-leading-zero);
  }
  .show-total {
    color: var(--color-muted);
  }
  .show-rail {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--color-hairline);
    border-radius: var(--radius-pill);
  }
  .show-mark {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: calc(100% / var(--n));
    background: var(--page-accent);
    border-radius: inherit;
    transform: translateX(calc(var(--step, 0) * 100%));
    transition: transform var(--dur-element) var(--ease-entrance);
  }

  /* ── Alternating ──────────────────────────────────────────────────────── */
  .alt {
    display: flex;
    flex-direction: column;
  }
  .alt-row {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0 1.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--color-hairline);
  }
  /* --color-control is 3.57:1 on paper and 3.32:1 on the Wash band this
     section sits on — §3 marks it non-text for exactly that reason. These
     numerals are decorative and aria-hidden, but they are still visible text,
     and aria-hidden does not exempt anything from 1.4.3. Muted is the floor. */
  .alt-n {
    color: var(--color-muted);
  }
  .alt-body {
    max-width: var(--prose-max-width);
  }
  @media (min-width: 900px) {
    /* Alternating sides, which is what makes this read as a sequence rather
       than a list. Numerals stay in the reading column either way. */
    .alt-row:nth-child(even) .alt-body {
      margin-left: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
    .tab {
      transition: none;
    }
    /* The marker still tracks the step — it just arrives instead of sliding.
       Removing it would leave the rail saying nothing. */
    .show-mark,
    .p-ind {
      transition: none;
    }
  }
</style>
