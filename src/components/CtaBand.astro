---
import Icon from './Icon.astro';
import { contact } from '../content/site';

/** `magnetic` is opt-in and off by default, because this band renders on nine
 *  routes and only /platforms/* is in §16's scope. Passing it adds one
 *  attribute; the six routes that do not pass it emit byte-identical HTML and
 *  load no extra script. */
interface Props {
  magnetic?: boolean;
  /** Opt-in grainy four-hue bloom behind the band. Off by default: this band
   *  renders on nine routes and only /platforms/* is in §16's scope, so the
   *  six that do not pass it emit byte-identical HTML. */
  atmos?: boolean;
  /** The Watermelon UI `cta-1` treatment: a contained card rather than a
   *  full-bleed band, copy left and the action right, with two blurred
   *  gradient shapes behind it. Opt-in for the same reason as the other two —
   *  the routes that do not pass it emit exactly the markup they did before. */
  card?: boolean;
}
const { magnetic = false, atmos = false, card = false } = Astro.props;

const heading = 'See a platform in action.';
const lede =
  'A 30-minute demo of any platform, run on your own facility type, board, practice area or city — or a conversation about partnership. We reply within one business day.';
---

{
  card ? (
    /* ── Watermelon UI cta-1, in this site's tokens ────────────────────────
       Kept from the reference: the contained card with a 1px accent border on
       an accent wash, `relative isolate overflow-hidden`, copy on the left and
       the action on the right, stacking to centred on mobile, and the two
       blurred clip-path shapes bleeding off either edge.

       THE ACCENT IS NEXUS INDIGO, NOT THE PAGE HUE. The reference tints the
       card with `bg-primary/10`, and on a platform page `--page-accent` is
       that platform's hue — which §15 forbids on a background. The site accent
       is not a platform hue, so the card carries it and the rule holds. It
       also reads as the same CTA on all nine routes, which is what a CTA
       should be.

       The blurred shapes are `aria-hidden` decoration and the card is legible
       without them: they sit behind an isolated stacking context at z-index
       -1, so nothing here can cover the heading or the buttons. */
    <section class="section cta-wrap">
      <div class="cta-card p-bloom p-grain">
        <div class="cta-inner">
          <div class="cta-copy">
            <h2 class="t-h2">{heading}</h2>
            <p class="t-body cta-lede">{lede}</p>
          </div>

          <div class="cta-actions">
            <a href="/contact/" class="btn btn-primary cta-btn tx-fast" data-magnetic={magnetic ? '' : undefined}>
              Book a demo <Icon name="arrow-right" class="arrow" />
            </a>
            <a href={contact.linkedin} target="_blank" rel="noopener" class="btn btn-secondary tx-fast">
              Connect on LinkedIn <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class={`section${atmos ? ' p-bloom p-grain p-cta' : ''}`} style="background: var(--color-wash);">
      <div class="shell text-center flex flex-col items-center gap-5">
        <h2 class="t-h2">{heading}</h2>
        <p class="t-lede" style="margin-inline: auto;">
          {lede}
        </p>
        <div class="mt-3 flex flex-wrap gap-3 justify-center">
          {/* The href and the label are in the HTML either way. initMagnetic adds
              pointer response to an anchor that already works. */}
          <a href="/contact/" class="btn btn-primary tx-fast" data-magnetic={magnetic ? '' : undefined}>
            Book a demo <Icon name="arrow-right" class="arrow" />
          </a>
          <a href={contact.linkedin} target="_blank" rel="noopener" class="btn btn-secondary tx-fast">
            Connect on LinkedIn <Icon name="arrow-up-right" size={14} />
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  /* A CARD, AT FULL WIDTH. Not the 1200px column and not edge to edge: the
     card is inset by the page gutter only, so it runs nearly the whole window
     and still reads as a card — corners, hairline and all. A rounded corner
     needs something outside it to be rounded against, which is what the
     gutter gives back.

     The ground is the one from "The four platforms" — Wash under the four-hue
     mesh and the grain, via .p-bloom and .p-grain. Those are platform.css
     classes and `card` is only ever passed on /platforms/*, which is where
     that stylesheet is loaded.

     The two blurred indigo shapes are gone with the tint they belonged to.
     A mesh and a pair of blobs are two atmospheres arguing; the mesh is the
     one that was asked for. */
  .cta-wrap {
    padding-inline: clamp(1.5rem, 4vw, 3rem);
  }
  .cta-card {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    padding-inline: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-panel);
    background: var(--color-wash);
    box-shadow: var(--shadow-1);
  }
  /* The copy stays on the page's grid even though the band does not: same
     max-width and gutter every other .shell on the site uses, so the heading
     lines up with the section above it. */
  .cta-inner {
    /* The card's own padding is the gutter now, so the copy sits inside the
       card rather than on the page grid — which is what a card is. */
    max-width: var(--page-max-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    text-align: center;
  }
  @media (min-width: 900px) {
    .cta-inner {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: 3rem;
    }
  }

  .cta-copy {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .cta-lede {
    color: var(--color-muted);
    max-width: 46ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    flex: none;
  }
  /* The reference's raised button: a light inset along the top edge, a dark
     one along the bottom, and a soft drop below. Built from --color-ink at low
     alpha so it introduces no colour the palette does not have. */
  .cta-btn {
    box-shadow:
      inset 0 2px 4px rgb(255 255 255 / 0.28),
      inset 0 -2px 5px rgb(11 18 32 / 0.12),
      0 8px 20px -6px rgb(11 18 32 / 0.18);
  }

</style>
