---
import Icon from './Icon.astro';
import { markIndic } from '../content/indic';
import type { Faq } from '../content/platform-detail';
interface Props {
  items: Faq[];
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {
    items.map((f, i) => (
      <details open={openFirst && i === 0}>
        <summary>
          {f.q}
          <Icon name="chevron-down" class="chev" size={18} />
        </summary>
        {/* Indic runs carry their real lang so screen readers switch voice and
            :lang() routes them to the Devanagari cut. JSON-LD keeps the plain
            string — structured data takes text, not markup. */}
        <p class="answer" set:html={markIndic(f.a)} />
      </details>
    ))
  }
</div>
