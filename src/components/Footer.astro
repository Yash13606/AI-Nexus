---
import Icon from './Icon.astro';
import { footerCols, productSites, contact, entities, orgDescription, isPlanned } from '../content/site';
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    {/* ── Brand + link columns ── */}
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <p class="t-h4" style="color: #fff;">AI Nexus Innovations Hub</p>
        <p class="t-sm" style="max-width: 44ch;">{orgDescription}</p>
        <span class="status-pill" role="status">
          <span class="status-pill__dot" aria-hidden="true"></span>
          All systems operational
        </span>
      </div>

      <div class="site-footer__cols">
        {
          footerCols.map((col) => (
            <div class="flex flex-col gap-3">
              <p class="t-label" style="color: #7c8ba5;">{col.title}</p>
              <ul class="list-none m-0 p-0 flex flex-col gap-2">
                {col.links.map((l) => (
                  <li>
                    {/* Planned-route text was #5f7089 — 3.71:1 on the ink footer, below AA. */}
                    {isPlanned(l.href) ? (
                      <span class="t-sm" style="color: #7280a0;">{l.label}</span>
                    ) : (
                      <a href={l.href} class="footer-link t-sm">
                        {l.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    {/* ── Office · Contact · Elsewhere ── */}
    <div class="site-footer__meta">
      <div class="flex flex-col gap-2">
        <p class="t-label" style="color: #7c8ba5;">Office</p>
        <p class="t-sm inline-flex items-center gap-1.5" style="color: #fff;">
          <Icon name="map-pin" size={14} />{contact.office}
        </p>
        <p class="t-sm">India</p>
      </div>

      <div class="flex flex-col gap-2">
        <p class="t-label" style="color: #7c8ba5;">Contact</p>
        <p class="t-sm inline-flex items-center gap-1.5">
          <Icon name="mail" size={14} />
          <a href={`mailto:${contact.email}`} class="footer-link mono" style="color: #fff;">{contact.email}</a>
        </p>
        <p class="t-sm inline-flex items-center gap-1.5">
          <Icon name="phone" size={14} />
          <a href={contact.phoneHref} class="footer-link mono" style="color: #fff;">{contact.phone}</a>
        </p>
        <p class="t-sm mono">{contact.hours}</p>
      </div>

      <div class="flex flex-col gap-2">
        <p class="t-label" style="color: #7c8ba5;">Elsewhere</p>
        <ul class="list-none m-0 p-0 flex flex-col gap-2">
          <li>
            <a href={contact.linkedin} target="_blank" rel="noopener" class="footer-link t-sm inline-flex items-center gap-1.5">
              LinkedIn <Icon name="arrow-up-right" size={13} />
            </a>
          </li>
          {productSites.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" class="footer-link t-sm inline-flex items-center gap-1.5">
                {s.label} <Icon name="arrow-up-right" size={13} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* ── Legal / copyright ── */}
    <div class="site-footer__bottom">
      <p class="t-cap mono" style="color: #7c8ba5;">
        {entities.map((e, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            {e.name}, {e.place.split(',')[0]} — {e.id}
          </>
        ))}
      </p>
      <div class="flex flex-col gap-1.5">
        <p class="t-cap" style="color: #7c8ba5;">Product examples on this site are illustrative.</p>
        <p class="t-cap" style="color: #94a2bd;">
          © 2026 AI Nexus Innovations Hub. Connecting Intelligence. Transforming Lives.
        </p>
      </div>
    </div>
  </div>

  {/* ── Oversized outlined wordmark — the footer's one flourish. Purely
        decorative, clipped by the footer's edges, no content behind it. ── */}
  <p class="site-footer__wordmark" aria-hidden="true">AI&nbsp;NEXUS</p>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-ink);
    color: #a8b4c8;
  }

  /* Accent glow pooling from the lower-left, echoing the hero card's bloom. */
  .site-footer::before {
    content: '';
    position: absolute;
    inset: auto -10% -40% -10%;
    height: 60%;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(60% 100% at 20% 100%, rgb(43 70 212 / 0.28), transparent 70%);
  }

  .site-footer__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(3.5rem, 6vw, 5rem) 2.5rem;
  }

  .site-footer__top {
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr;
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .site-footer__cols {
    display: grid;
    gap: 2.5rem 1.5rem;
    grid-template-columns: repeat(2, 1fr);
  }

  .site-footer__meta {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .site-footer__bottom {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  @media (min-width: 640px) {
    .site-footer__meta {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .site-footer__top {
      grid-template-columns: 1.5fr 3fr;
      gap: 4rem;
    }
    .site-footer__cols {
      grid-template-columns: repeat(4, 1fr);
    }
    .site-footer__bottom {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .site-footer__bottom > :last-child {
      text-align: right;
    }
  }

  /* Footer links — muted at rest, white on hover, with an accent underline
     that grows from the left. No layout shift. */
  .footer-link {
    color: #a8b4c8;
    text-decoration: none;
    position: relative;
    transition: color var(--dur-micro) var(--ease-entrance);
  }
  .footer-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 1px;
    width: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-micro) var(--ease-entrance);
  }
  .footer-link:hover {
    color: #fff;
  }
  .footer-link:hover::after {
    transform: scaleX(1);
  }

  /* Status pill — a live-signal affordance. The dot pulses; the global
     reduced-motion kill switch stops it. */
  .status-pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(255 255 255 / 0.04);
    font-size: var(--text-caption);
    color: #cdd6e6;
  }
  .status-pill__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-verified);
    box-shadow: 0 0 0 0 rgb(14 124 123 / 0.5);
    animation: status-pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes status-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(14 124 123 / 0.5);
    }
    70% {
      box-shadow: 0 0 0 6px rgb(14 124 123 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(14 124 123 / 0);
    }
  }

  /* The wordmark. Outlined, not filled — a watermark, not a headline. Sits at
     the very bottom, partly clipped by the footer edge so it reads as texture. */
  .site-footer__wordmark {
    position: absolute;
    left: 50%;
    bottom: clamp(-1.5rem, -2vw, -0.5rem);
    transform: translateX(-50%);
    z-index: 1;
    margin: 0;
    white-space: nowrap;
    font-weight: 700;
    font-size: clamp(4.5rem, 20vw, 18rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.07);
    text-stroke: 1px rgb(255 255 255 / 0.07);
    pointer-events: none;
    user-select: none;
  }
</style>
