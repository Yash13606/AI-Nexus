---
/** Progressive blur at a container's edge.
 *
 *  A port of React Bits' GradualBlur. That component's runtime work is
 *  generating N divs and merging presets; both are known at build time
 *  here, so this renders as static HTML and ships no JavaScript.
 *
 *  The parent must be `position: relative`.
 *
 *  Stacked backdrop-filter is genuinely expensive to composite — keep
 *  `layers` at 6 or below and use one instance per page.
 */
interface Props {
  /** Which edge the blur ramps from. */
  position?: 'top' | 'bottom' | 'left' | 'right';
  /** Thickness of the ramp, any CSS length. */
  size?: string;
  /** Blur multiplier. 1 is subtle, 3 is heavy. */
  strength?: number;
  /** Number of stacked layers. More is smoother and more expensive. */
  layers?: number;
  class?: string;
}

const { position = 'bottom', size = '6rem', strength = 2, layers = 5, class: cls = '' } = Astro.props;

/** Mask ramps run toward the named edge, so the blur fades into the page. */
const direction = { top: 'to top', bottom: 'to bottom', left: 'to left', right: 'to right' }[position];

const vertical = position === 'top' || position === 'bottom';
const box = vertical
  ? `height: ${size}; left: 0; right: 0; ${position}: 0;`
  : `width: ${size}; top: 0; bottom: 0; ${position}: 0;`;

/** Each layer masks in one band and blurs harder than the last, so the
 *  ramp reads as continuous rather than as N visible steps. */
const bands = Array.from({ length: layers }, (_, i) => {
  const step = 100 / layers;
  const blur = (0.0625 * (((i + 1) / layers) * layers + 1) * strength).toFixed(3);
  const start = +(step * i).toFixed(1);
  const mid = +(step * (i + 1)).toFixed(1);
  const late = +(step * (i + 2)).toFixed(1);
  let ramp = `transparent ${start}%, #000 ${mid}%`;
  if (late <= 100) ramp += `, transparent ${late}%`;
  return `-webkit-mask-image: linear-gradient(${direction}, ${ramp}); mask-image: linear-gradient(${direction}, ${ramp}); -webkit-backdrop-filter: blur(${blur}rem); backdrop-filter: blur(${blur}rem);`;
});
---

<div class={`grad-blur ${cls}`} style={box} aria-hidden="true">
  {bands.map((s) => <span style={s} />)}
</div>
