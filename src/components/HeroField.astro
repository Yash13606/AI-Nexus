---
/** The /platforms/ hero field: a static four-hue gradient, with a WebGL
 *  particle structure drawn over it when the machine and the reader both want
 *  one. Derived from the earlier CSS-only HeroField (commit 667770e) — its
 *  placement contract, its double-gated reduced-motion handling and its
 *  "resting state is the finished state" rule all carry forward unchanged.
 *
 *  PLACEMENT CONTRACT. Must be the first child of a hero that is
 *  `position: relative` and `overflow: hidden`, with its own content in a
 *  sibling that establishes a stacking context above this one. This element
 *  positions itself; the hero only has to clip it.
 *
 *  THE STATIC LAYER IS NOT A FALLBACK. It renders on every path, always, and
 *  the canvas fades in on top of it — so the four bail cases are not degraded
 *  versions of a hero, they are the hero with one layer fewer. There is no path
 *  where something is visibly missing. The four hues appear in both layers, in
 *  the same arrangement, so the argument the field makes survives all four.
 *
 *  THE FOUR BAILS, all resolved before the module is fetched, except the last:
 *    · prefers-reduced-motion: reduce   — the field is motion and nothing else
 *    · hardwareConcurrency < 4          — measured, not sniffed. Undefined is
 *                                         treated as capable; only an explicit
 *                                         low count bails, so old Safari (which
 *                                         does not report it) is not punished
 *    · viewport <= 768px                — gated in the loader, so the module is
 *                                         never even downloaded on a phone
 *    · WebGL context/link failure       — the only one that cannot be predicted.
 *                                         initField returns false and data-live
 *                                         is never set, leaving the static layer
 *                                         at full strength
 *
 *  aria-hidden, empty, pointer-events: none. It carries no content, so nothing
 *  it does can hide anything from a crawler or a screen reader. */
interface Props {
  /** Comma-separated custom-property names for the strand colours. One name
   *  makes the four strands four tones of it — see strandHues in field.js.
   *  Defaults to the four platform hues, which is what /platforms/ wants. */
  hues?: string;
  /** `quad` tints the static layer in all four hues; `single` uses the page
   *  accent, so a platform page's fallback stays in its own colour. */
  tone?: 'quad' | 'single';
  /** Nudges the form right, in clip-space units where the canvas spans -1..1 —
   *  so 0.1 moves it 5% of the canvas width. Applied to BOTH layers: the shader
   *  takes it as a uniform, the static gradients as a percentage, so a bail
   *  path puts the object in the same place the canvas would have. Ignored
   *  below 1100px, where the field is under the text and centred in its own
   *  box. */
  shift?: number;
}
const { hues, tone = 'quad', shift = 0 } = Astro.props;
---

<div
  class={`hf hf-${tone}`}
  aria-hidden="true"
  style={shift ? `--hf-shift: ${shift * 50}%;` : undefined}
>
  <span class="hf-static"></span>
  <canvas
    class="hf-canvas"
    data-hero-field
    data-hues={hues}
    data-ox-shift={shift || undefined}
  ></canvas>
</div>

<script>
  const el = document.querySelector<HTMLCanvasElement>('[data-hero-field]');
  if (
    el &&
    matchMedia('(min-width: 769px)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    (navigator.hardwareConcurrency ?? 8) >= 4
  ) {
    /* Dynamic, so the field is its own chunk and the three cheap gates above
       decide whether it is ever requested. A phone, a throttled machine and a
       reduced-motion reader all pay zero bytes for it. */
    import('../scripts/motion/field.js')
      .then((m) => {
        if (m.initField(el)) el.parentElement?.setAttribute('data-live', '');
      })
      .catch(() => {});
  }
</script>

<style>
  /* Anchored to the TOP of the hero at a fixed height, not stretched to fill
     it. The heroes are not the same height — the ledes run from three lines to
     ten, so they measure 640px to 1096px — and a field that fills its hero puts
     the form at a different place on every page. Moving between platforms then
     reads as the object jumping rather than the page changing.

     Top-anchored and fixed, the form lands at the same offset below the sticky
     sub-nav on all five routes, and field.js's u_fit already holds it to one
     size. Same object, same place, whichever page you arrive on. */
  .hf {
    position: absolute;
    /* Centred, not top-anchored. Every hero is now the same height on a given
       screen, so centring is identical across the five pages — and in a tall
       hero a top-anchored form left the bottom third empty. The box stays a
       fixed 40rem either way, so the form's size never changes. */
    top: 50%;
    translate: 0 -50%;
    left: 0;
    right: 0;
    /* A FIXED height, not min(100%, 40rem). With the min, a hero shorter than
       40rem shrank the canvas — and field.js scales from the canvas, so the
       form came out smaller and higher on those pages. Measured: the top edge
       drifted from a 8px spread to 19px once the heroes were tightened.

       Fixed, the canvas is always 640px whatever the hero does, so u_fit and
       the top anchor are both constant. The hero's `overflow: hidden` clips
       whatever hangs below, and the form itself ends around 520px so nothing
       of it is ever cut. */
    height: 40rem;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hf-static,
  .hf-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The same object, unlit. A tall mist spindle at the axis the particle form
     turns on, with four hue nodes on it at the heights the strands cross — so
     the count is legible without the canvas, and the bail paths inherit the
     argument rather than a smear. Percentages are token mixes rather than
     rgba() so the hues stay single-sourced. */
  .hf-static {
    background:
      radial-gradient(11% 21% at 69% 19%, color-mix(in oklab, var(--color-medorbit) 30%, transparent), transparent 72%),
      radial-gradient(11% 21% at 79% 40%, color-mix(in oklab, var(--color-edvation) 27%, transparent), transparent 72%),
      radial-gradient(11% 21% at 68% 63%, color-mix(in oklab, var(--color-advohub) 26%, transparent), transparent 72%),
      radial-gradient(11% 21% at 78% 84%, color-mix(in oklab, var(--color-trustproperty) 30%, transparent), transparent 72%),
      radial-gradient(13% 44% at 73% 50%, var(--color-mist), transparent 74%),
      radial-gradient(34% 78% at 74% 50%, var(--color-wash), transparent 76%);
    transition: opacity var(--dur-section) var(--ease-entrance);
  }

  /* A single platform page has one hue, so its static layer is four steps of
     that hue rather than four different ones. Same arrangement, same spindle,
     same count — just in the page's own colour. */
  /* --hf-shift moves the static spindle by the same distance the shader moves
     the particle form, so the bail paths land the object where the canvas
     would have. Half of the clip-space value, because clip space spans -1..1
     across a box that is 100% wide. Defaults to 0, so /platforms/ — which
     passes no shift — computes byte-identical positions to before. */
  .hf-single .hf-static {
    background:
      radial-gradient(11% 21% at calc(69% + var(--hf-shift, 0%)) 19%, color-mix(in oklab, var(--page-accent) 30%, transparent), transparent 72%),
      radial-gradient(11% 21% at calc(79% + var(--hf-shift, 0%)) 40%, color-mix(in oklab, var(--page-accent) 20%, transparent), transparent 72%),
      radial-gradient(11% 21% at calc(68% + var(--hf-shift, 0%)) 63%, color-mix(in oklab, var(--page-accent) 26%, transparent), transparent 72%),
      radial-gradient(11% 21% at calc(78% + var(--hf-shift, 0%)) 84%, color-mix(in oklab, var(--page-accent) 16%, transparent), transparent 72%),
      radial-gradient(13% 44% at calc(73% + var(--hf-shift, 0%)) 50%, var(--color-mist), transparent 74%),
      radial-gradient(34% 78% at calc(74% + var(--hf-shift, 0%)) 50%, var(--color-wash), transparent 76%);
  }
  @media (max-width: 1099px) {
    .hf-single .hf-static {
      background:
        radial-gradient(13% 26% at 17% 56%, color-mix(in oklab, var(--page-accent) 32%, transparent), transparent 72%),
        radial-gradient(13% 26% at 39% 47%, color-mix(in oklab, var(--page-accent) 21%, transparent), transparent 72%),
        radial-gradient(13% 26% at 61% 56%, color-mix(in oklab, var(--page-accent) 28%, transparent), transparent 72%),
        radial-gradient(13% 26% at 83% 47%, color-mix(in oklab, var(--page-accent) 17%, transparent), transparent 72%),
        radial-gradient(46% 15% at 50% 52%, var(--color-mist), transparent 74%),
        radial-gradient(76% 46% at 50% 52%, var(--color-wash), transparent 78%);
    }
  }

  /* Once the canvas is genuinely drawing, the static layer steps back to being
     a ground for it rather than the subject. */
  .hf[data-live] .hf-static {
    opacity: 0.42;
  }

  .hf-canvas {
    opacity: 0;
    transition: opacity var(--dur-section) var(--ease-entrance);
  }
  .hf[data-live] .hf-canvas {
    opacity: 1;
  }

  /* The scrim is what carries text legibility, and it is a flat paper plate
     under the reading column — not a soft veil that merely reduces the problem.
     Text never sits on a partially transparent particle wash. */
  .hf::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      96deg,
      var(--color-paper) 0%,
      var(--color-paper) 48%,
      color-mix(in oklab, var(--color-paper) 55%, transparent) 64%,
      transparent 84%
    );
  }

  /* Between 769 and 1099 there is no empty right of the text, so the whole
     field drops beneath it and the scrim turns vertical. Same object, different
     room for it. */
  @media (max-width: 1099px) {
    .hf {
      inset: auto 0 0 0;
      height: min(56%, 26rem);
    }
    /* Turned on its side: the spindle lies down and the four nodes read left to
       right. Same object, same count, rotated into the room it has. */
    .hf-static {
      background:
        radial-gradient(13% 26% at 17% 56%, color-mix(in oklab, var(--color-medorbit) 32%, transparent), transparent 72%),
        radial-gradient(13% 26% at 39% 47%, color-mix(in oklab, var(--color-edvation) 29%, transparent), transparent 72%),
        radial-gradient(13% 26% at 61% 56%, color-mix(in oklab, var(--color-advohub) 28%, transparent), transparent 72%),
        radial-gradient(13% 26% at 83% 47%, color-mix(in oklab, var(--color-trustproperty) 32%, transparent), transparent 72%),
        radial-gradient(46% 15% at 50% 52%, var(--color-mist), transparent 74%),
        radial-gradient(76% 46% at 50% 52%, var(--color-wash), transparent 78%);
    }
    .hf::after {
      background: linear-gradient(
        to bottom,
        var(--color-paper) 0%,
        color-mix(in oklab, var(--color-paper) 55%, transparent) 26%,
        transparent 58%
      );
    }
  }

  /* Phones never load the module, so this is the whole hero field there. It is
     designed as its own thing rather than as a leftover: a low four-hue sweep
     under the buttons, which is the same statement the spindle makes. */
  @media (max-width: 768px) {
    .hf {
      height: min(44%, 20rem);
    }
  }

  /* Belt and braces, exactly as the CSS field did it: the loader already
     refuses to start under reduce, and this would flatten it regardless. */
  @media (prefers-reduced-motion: reduce) {
    .hf-static,
    .hf-canvas {
      transition: none;
    }
  }
</style>
