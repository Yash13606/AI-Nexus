---
/** Authored SVG icon set. One stroke weight (1.5), one grid (16).
 *  The craft floor bans unicode glyphs and emoji standing in for icons.
 *  Path data lives in src/lib/icon-paths.ts, shared with any plain-React
 *  island that needs the same glyphs. */
import { iconPaths, type IconName } from '../lib/icon-paths';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 16, class: cls = '' } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={iconPaths[name]}
/>
