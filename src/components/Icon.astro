---
/** Authored SVG icon set. One stroke weight (1.5), one grid (16).
 *  The craft floor bans unicode glyphs and emoji standing in for icons. */
type Name = 'check' | 'arrow-right' | 'arrow-up-right' | 'chevron-down' | 'menu' | 'close' | 'rule';
interface Props {
  name: Name;
  size?: number;
  class?: string;
}
const { name, size = 16, class: cls = '' } = Astro.props;

const paths: Record<Name, string> = {
  check: '<path d="M3 8.5 6.2 12 13 4.5"/>',
  'arrow-right': '<path d="M3 8h10"/><path d="M9 4l4 4-4 4"/>',
  'arrow-up-right': '<path d="M5 11 11 5"/><path d="M5.6 5H11v5.4"/>',
  'chevron-down': '<path d="m4 6.5 4 4 4-4"/>',
  menu: '<path d="M2.5 5h11"/><path d="M2.5 11h11"/>',
  close: '<path d="M4 4l8 8"/><path d="M12 4l-8 8"/>',
  rule: '<path d="M2 8h12"/>',
};
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
