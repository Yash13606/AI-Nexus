---
/** The four platform lockups, drifting. Decoration, and declared as such.
 *
 *  aria-hidden and link-free on purpose. All four names are already reachable
 *  as links in the siblings grid directly below, so this adds no content a
 *  reader can miss and no link a crawler has to weigh. It is a brand strip, not
 *  navigation.
 *
 *  CSS keyframes, no JavaScript. The track is rendered twice and translated by
 *  exactly -50%, which is what makes the loop seamless — animating to -100% of
 *  a single copy snaps back visibly at the wrap.
 *
 *  Pauses on hover, so a reader who wants to look at a name can. Edges are
 *  masked rather than faded with an overlay, so the strip works on any band
 *  colour without a matching gradient having to be maintained. */
import { platforms } from '../content/platforms';

const track = [...platforms, ...platforms];
---

<div class="mq" aria-hidden="true">
  <div class="mq-track">
    {
      track.map((p) => (
        <span class="mq-item" style={`--hue: ${p.hue};`}>
          <span class="mq-dot" />
          {p.name}
        </span>
      ))
    }
  </div>
</div>

<style>
  .mq {
    overflow: hidden;
    /* Both prefixes: Safari still needs -webkit-mask for this. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .mq-track {
    display: flex;
    align-items: center;
    gap: 4rem;
    width: max-content;
    padding-block: 1.25rem;
    animation: mq 38s linear infinite;
  }
  .mq:hover .mq-track {
    animation-play-state: paused;
  }
  .mq-item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-control);
    white-space: nowrap;
    transition: color var(--dur-micro) var(--ease-entrance);
  }
  .mq-item:hover {
    color: var(--color-ink);
  }
  .mq-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--hue);
    flex: none;
  }

  /* -50% of a doubled track is exactly one copy, so the second copy is in the
     first's position at the wrap and there is nothing to see. */
  @keyframes mq {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mq-track {
      animation: none;
    }
  }
</style>
