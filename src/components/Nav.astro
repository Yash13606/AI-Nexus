---
/** The one nav, every page including home, one markup for every viewport —
 *  no hamburger, no duplicate mobile list. It wraps onto its own line on
 *  narrow screens instead of hiding behind a toggle. Platforms and
 *  Solutions — the two items with real children — are real links (so
 *  tapping on touch still goes somewhere) that also reveal a dropdown on
 *  hover/focus for desktop mouse and keyboard use.
 *
 *  Dropdown hit-testing: the gap between the trigger and the panel is
 *  bridged with padding on the OUTER wrapper (.nav-dropdown-panel), not
 *  margin — margin doesn't count as part of the element's own box, so a
 *  margin-based gap is a dead zone the mouse falls through on the way
 *  down, closing the menu before you can reach it. Padding does count,
 *  so the hoverable area is unbroken from the trigger to the card. The
 *  inner .nav-dropdown-card only handles the visual chrome + entrance
 *  animation, never the hit-testing. */
import Icon from './Icon.astro';
import { nav, footerCols, isPlanned } from '../content/site';
import { platforms } from '../content/platforms';

const solutionLinks = footerCols.find((c) => c.title === 'Solutions')!.links;
---

<header
  id="site-nav"
  class="sticky top-0 z-50 tx-fast"
  style="background: var(--color-paper); border-bottom: 1px solid var(--color-hairline);"
>
  <div class="shell flex flex-wrap items-center justify-between gap-x-6 gap-y-3" style="padding-block: 14px;">
    <a href="/" class="nav-logo no-underline" style="color: var(--color-ink);">
      <img src="/logo-mark.png" alt="" class="nav-logo-mark" />
      <span class="t-h4 tracking-[-0.02em]">AI Nexus</span>
    </a>

    <div class="flex items-center gap-4 order-2 shrink-0">
      <a href="/login/" class="t-sm no-underline tx-fast" style="color: var(--color-body);">Log in</a>
      <a href="/contact/" class="btn btn-primary tx-fast">Book a demo</a>
    </div>

    <nav aria-label="Primary" class="flex flex-wrap items-center gap-x-7 gap-y-2 order-3 w-full lg:order-none lg:w-auto">
      <div class="nav-dropdown">
        <a href="/platforms/" class="t-sm no-underline tx-fast nav-link" style="color: var(--color-body);">
          Platforms <Icon name="chevron-down" size={12} class="nav-chevron" />
        </a>
        <div class="nav-dropdown-panel">
          <div class="nav-dropdown-card nav-dropdown-card--platforms">
            {platforms.map((p) => (
              <a href={`/platforms/${p.slug}/`} class="platform-item" style={`--hue: ${p.hue};`}>
                <span class="platform-item-name">{p.name}</span>
                <span class="platform-item-subtitle">{p.subtitle}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/ai-agents/" class="t-sm no-underline tx-fast" style="color: var(--color-body);">AI agents</a>

      <div class="nav-dropdown">
        <a href="/solutions/hospitals/" class="t-sm no-underline tx-fast nav-link" style="color: var(--color-body);">
          Solutions <Icon name="chevron-down" size={12} class="nav-chevron" />
        </a>
        <div class="nav-dropdown-panel">
          <div class="nav-dropdown-card">
            {solutionLinks.map((l) => (
              <a href={l.href} class="plain-link">{l.label}</a>
            ))}
          </div>
        </div>
      </div>

      {
        nav
          .filter((item) => item.label !== 'Platforms' && item.label !== 'Solutions')
          .map((item) =>
            isPlanned(item.href) ? (
              <span class="t-sm" style="color: var(--color-muted);" title="Coming soon">
                {item.label}
              </span>
            ) : (
              <a href={item.href} class="t-sm no-underline tx-fast hover:text-[--color-ink]" style="color: var(--color-body);">
                {item.label}
              </a>
            )
          )
      }
    </nav>
  </div>
</header>

<style>
  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .nav-logo-mark {
    height: 28px;
    width: auto;
    display: block;
  }

  .nav-dropdown {
    position: relative;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .nav-chevron {
    transition: transform var(--dur-state) var(--ease-out);
    color: var(--color-control);
  }
  .nav-dropdown:hover .nav-chevron,
  .nav-dropdown:focus-within .nav-chevron {
    transform: rotate(180deg);
  }

  /* Outer wrapper: positioning + the hit-testing bridge. Never moves,
     never scales — only opacity/visibility toggle here, so the hoverable
     region is stable the instant the trigger is entered. */
  .nav-dropdown-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    padding-top: 10px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur-feedback) var(--ease-out), visibility var(--dur-feedback) var(--ease-out);
  }
  .nav-dropdown:hover .nav-dropdown-panel,
  .nav-dropdown:focus-within .nav-dropdown-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Inner card: all the visual chrome and the entrance motion. */
  .nav-dropdown-card {
    min-width: 210px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px;
    background: var(--color-paper);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-panel);
    box-shadow: var(--shadow-sticky);
    transform: translateY(6px) scale(0.98);
    transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .nav-dropdown:hover .nav-dropdown-card,
  .nav-dropdown:focus-within .nav-dropdown-card {
    transform: translateY(0) scale(1);
  }

  .plain-link {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: var(--text-body-sm);
    color: var(--color-body);
    text-decoration: none;
    transition: background-color var(--dur-feedback) var(--ease-out), color var(--dur-feedback) var(--ease-out);
  }
  .plain-link:hover,
  .plain-link:focus-visible {
    background: var(--color-mist);
    color: var(--color-ink);
  }

  /* Platforms gets the richer treatment: a wider 2-up grid of real
     product identity (name + subtitle + hue), not a bare link list —
     the site's established platform-tag language, not a fake screenshot. */
  .nav-dropdown-card--platforms {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
    min-width: 420px;
    padding: 10px;
  }
  .platform-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 14px 12px 16px;
    border-left: 2px solid var(--hue);
    border-radius: 10px;
    text-decoration: none;
    transition: background-color var(--dur-feedback) var(--ease-out);
  }
  .platform-item:hover,
  .platform-item:focus-visible {
    background: var(--color-wash);
  }
  .platform-item-name {
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-ink);
  }
  .platform-item-subtitle {
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .nav-dropdown-card--platforms {
      grid-template-columns: 1fr;
      min-width: 260px;
    }
  }
</style>

<script>
  // The only JavaScript in this component: the scroll shadow. Everything
  // else — the dropdown reveal, the responsive wrap — is CSS only.
  const navEl = document.getElementById('site-nav');
  const onScroll = () => {
    if (!navEl) return;
    navEl.style.boxShadow = window.scrollY > 8 ? 'var(--shadow-sticky)' : '';
  };
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>
