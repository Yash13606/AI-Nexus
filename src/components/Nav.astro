---
/** Floating pill navbar. A rounded, frosted bar detached from the top edge;
 *  content scrolls through the gaps beside it. Desktop dropdowns are CSS-only
 *  (hover + focus-within), so the menu works with no JavaScript; the single
 *  script drives the mobile disclosure and a scrolled-state class only.
 *
 *  Platforms and Solutions are real links (a tap on touch still navigates)
 *  that also reveal a panel on desktop. The gap between a trigger and its
 *  panel is bridged with padding on the OUTER wrapper (.nav-panel), never
 *  margin — margin is a dead zone the pointer falls through, closing the menu
 *  before it can be reached. */
import Icon from './Icon.astro';
import { nav, footerCols, isPlanned } from '../content/site';
import { platforms } from '../content/platforms';

const solutionLinks = footerCols.find((c) => c.title === 'Solutions')!.links;
/** The three links that are rendered from content, in content order.
 *
 *  Platforms and Solutions are excluded because they are written out by hand
 *  above, with their panels. AI agents is excluded for the same reason and was
 *  missing from this list — it is hard-coded between Platforms and Solutions to
 *  hold that position, and then this map rendered it a second time. Both menus
 *  listed it twice on all 19 routes.
 *
 *  Matched on href, not label: a label is copy and copy gets edited, at which
 *  point a filter keyed to it silently stops matching and the duplicate comes
 *  back. The href is the identity. */
const handWritten = new Set(['/platforms/', '/ai-agents/', '/solutions/hospitals/']);
const flatLinks = nav.filter((item) => !handWritten.has(item.href));

/** True when every solution page is held back, which is what decides whether
 *  the "Solutions" trigger may still be a link. */
const solutionsPlanned = solutionLinks.every((l) => isPlanned(l.href));
---

<div class="nav-wrap" id="site-nav">
  <header class="nav-pill">
    <a href="/" class="nav-brand" aria-label="AI Nexus home">
      {/* The real brand mark, in the slot the pill nav reserves for it —
          this replaced a placeholder geometric SVG. */}
      <span class="nav-mark" aria-hidden="true">
        <img src="/logo-mark.png" alt="" />
      </span>
      <span class="nav-brand-text">AI Nexus</span>
    </a>

    {/* ── Desktop menu ── */}
    <nav class="nav-menu" aria-label="Primary">
      {/* A plain link, no panel. The mega-menu that was here listed the four
          platforms with their subtitles — which is exactly what the sub-nav on
          /platforms/* does, permanently and without a hover. Two controls for
          one job, and the hover one was the worse of the two: it needs a
          pointer, it closes when you leave it, and it duplicated a strip that
          is already on screen. The sub-nav now carries the platform hues the
          mega-menu had, so nothing it showed was lost — see PlatformSubnav. */}
      <a href="/platforms/" class="nav-link">Platforms</a>

      <a href="/ai-agents/" class="nav-link">AI agents</a>

      {/* The trigger points at the first solution page, so when that page is
          held back the trigger cannot stay a link — it would navigate to the
          very page the panel below labels "Coming soon". It becomes a plain
          button-less span in that case and still opens the panel, which is
          hover/focus-driven and never needed the href. */}
      <div class="nav-item nav-has-menu">
        {solutionsPlanned ? (
          <span class="nav-link" tabindex="0" role="button" aria-expanded="false">
            Solutions <Icon name="chevron-down" size={12} class="nav-chevron" />
          </span>
        ) : (
          <a href="/solutions/hospitals/" class="nav-link">
            Solutions <Icon name="chevron-down" size={12} class="nav-chevron" />
          </a>
        )}
        <div class="nav-panel">
          <div class="nav-card nav-list">
            {solutionLinks.map((l) =>
              isPlanned(l.href) ? (
                <span class="list-item is-planned">
                  {l.label}
                  <span class="soon">Coming soon</span>
                </span>
              ) : (
                <a href={l.href} class="list-item">{l.label}</a>
              )
            )}
          </div>
        </div>
      </div>

      {
        flatLinks.map((item) =>
          isPlanned(item.href) ? (
            <span class="nav-link is-planned" title="Coming soon">{item.label}</span>
          ) : (
            <a href={item.href} class="nav-link">{item.label}</a>
          )
        )
      }
    </nav>

    {/* ── Actions ── */}
    <div class="nav-actions">
      <a href="/login/" class="nav-login">Log in</a>
      <a href="/contact/" class="btn btn-primary nav-cta">Book a demo</a>
      <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav-mobile">
        <Icon name="menu" size={20} class="nav-toggle-open" />
        <Icon name="close" size={20} class="nav-toggle-close" />
      </button>
    </div>
  </header>

  {/* ── Mobile disclosure ── */}
  <div id="nav-mobile" class="nav-mobile" hidden>
    <p class="nav-mobile-label">Platforms</p>
    {platforms.map((p) => (
      <a href={`/platforms/${p.slug}/`} class="nav-mobile-link" style={`--hue: ${p.hue};`}>
        <span class="mega-item-dot" aria-hidden="true"></span>{p.name}
      </a>
    ))}
    <a href="/ai-agents/" class="nav-mobile-link nav-mobile-link--plain">AI agents</a>

    <p class="nav-mobile-label">Solutions</p>
    {solutionLinks.map((l) =>
      isPlanned(l.href) ? (
        <span class="nav-mobile-link nav-mobile-link--plain is-planned">
          {l.label}
          <span class="soon">Coming soon</span>
        </span>
      ) : (
        <a href={l.href} class="nav-mobile-link nav-mobile-link--plain">{l.label}</a>
      )
    )}

    <div class="nav-mobile-rule"></div>
    {flatLinks.map((item) => (
      <a href={item.href} class="nav-mobile-link nav-mobile-link--plain">{item.label}</a>
    ))}
    <div class="nav-mobile-actions">
      <a href="/login/" class="btn btn-secondary">Log in</a>
      <a href="/contact/" class="btn btn-primary">Book a demo</a>
    </div>
  </div>
</div>

<style>
  .nav-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    /* --nav-pad-y is the same clamp, lifted to theme.css so --nav-h can be
       composed from it. Identical computed value. */
    padding: var(--nav-pad-y) clamp(0.75rem, 3vw, 1.5rem);
  }

  .nav-pill {
    max-width: var(--page-max-width);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 60px;
    padding-inline: 0.75rem 0.75rem;
    padding-left: 1.25rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: color-mix(in oklab, var(--color-paper) 82%, transparent);
    backdrop-filter: blur(14px) saturate(150%);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    transition:
      box-shadow var(--dur-state) var(--ease-out),
      border-color var(--dur-state) var(--ease-out),
      background-color var(--dur-state) var(--ease-out);
  }
  /* Deepen the pill once the page scrolls under it. */
  .nav-wrap.is-scrolled .nav-pill {
    border-color: color-mix(in oklab, var(--color-hairline) 70%, var(--color-control));
    background: color-mix(in oklab, var(--color-paper) 90%, transparent);
    box-shadow: 0 8px 28px -14px rgb(11 18 32 / 0.28);
  }

  /* ── Brand ── */
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-ink);
    font-size: var(--text-h4);
    font-weight: 600;
    letter-spacing: -0.02em;
    flex: none;
  }
  .nav-mark {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-accent);
  }
  .nav-mark svg,
  .nav-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ── Desktop menu ── */
  .nav-menu {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }
  .nav-item {
    position: relative;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-pill);
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-body);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--dur-feedback) var(--ease-out),
      background-color var(--dur-feedback) var(--ease-out);
  }
  .nav-link:hover,
  .nav-item:hover .nav-link,
  .nav-item:focus-within .nav-link {
    color: var(--color-ink);
    background: var(--color-mist);
  }
  .nav-link.is-planned {
    color: var(--color-muted);
    cursor: default;
  }

  /* ── Held-back routes ──
     A planned entry is a <span>, not an <a>, so it is already out of the tab
     order and cannot be followed. The chip is what says why — a title
     attribute would not survive touch, where there is no hover. */
  .list-item.is-planned,
  .nav-mobile-link.is-planned {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--color-muted);
    cursor: default;
  }
  .list-item.is-planned:hover,
  .nav-mobile-link.is-planned:hover {
    background: none;
    color: var(--color-muted);
  }
  /* `.soon` itself lives in theme.css — the seat cards on the home page use
     the same chip, and a scoped style here would not reach them. */
  /* :global on the icon's own class, because it is a class passed to a CHILD
     COMPONENT. Astro does not put this file's `data-astro-cid` on a child
     component's root element, so `.nav-chevron { … }` compiles to
     `.nav-chevron[data-astro-cid-…]` and matches nothing — the rule is in the
     stylesheet, is syntactically valid, and has never had any effect. The
     ancestor (`.nav-item`, `.nav-link`) is in this file and is scoped
     normally, so the pair is still confined to this component.

     DESIGN.md §14b records this as fragility 2 and as the first instance of
     the failure class. It was live in three more places here. */
  .nav-link :global(.nav-chevron) {
    color: var(--color-control);
    transition: transform var(--dur-state) var(--ease-out);
  }
  .nav-item:hover .nav-link :global(.nav-chevron),
  .nav-item:focus-within .nav-link :global(.nav-chevron) {
    transform: rotate(180deg);
  }

  /* ── Dropdown panels ── */
  .nav-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    padding-top: 12px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur-feedback) var(--ease-out),
      visibility var(--dur-feedback) var(--ease-out);
  }
  .nav-item:hover .nav-panel,
  .nav-item:focus-within .nav-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .nav-card {
    background: var(--color-paper);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-panel);
    box-shadow: 0 18px 48px -20px rgb(11 18 32 / 0.28);
    transform: translateY(6px) scale(0.985);
    transform-origin: top center;
    transition: transform var(--dur-state) cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .nav-item:hover .nav-card,
  .nav-item:focus-within .nav-card {
    transform: translateY(0) scale(1);
  }

  /* Solutions — a simple padded list. */
  .nav-list {
    min-width: 230px;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .list-item {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-button);
    font-size: var(--text-body-sm);
    color: var(--color-body);
    text-decoration: none;
    transition:
      background-color var(--dur-feedback) var(--ease-out),
      color var(--dur-feedback) var(--ease-out);
  }
  .list-item:hover,
  .list-item:focus-visible {
    background: var(--color-mist);
    color: var(--color-ink);
  }

  /* The mobile sheet's platform links keep the hue dot the mega panel used.
     Everything else that panel needed — its grid, its two-line items, its
     featured card — went with it. */
  .mega-item-dot {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    margin-top: 0.35rem;
    border-radius: var(--radius-pill);
    background: var(--hue);
  }

  /* ── Actions ── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: none;
  }
  .nav-login {
    display: none;
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-body);
    text-decoration: none;
    padding: 0.4rem 0.5rem;
    transition: color var(--dur-feedback) var(--ease-out);
  }
  .nav-login:hover {
    color: var(--color-ink);
  }
  .nav-cta {
    border-radius: var(--radius-pill);
  }

  /* Hamburger — mobile only. */
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-paper);
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color var(--dur-feedback) var(--ease-out);
  }
  .nav-toggle:hover {
    border-color: var(--color-control);
  }
  /* Same fix, and this one was VISIBLE: both icons painted on top of each
     other at every mobile width, so the button read as a hamburger with a
     cross through it. `.nav-toggle-close { display: none }` was scoped, the
     svg it targets is a child component's root, and the two never met. */
  .nav-toggle :global(.nav-toggle-close) {
    display: none;
  }
  .nav-wrap.is-open .nav-toggle :global(.nav-toggle-open) {
    display: none;
  }
  .nav-wrap.is-open .nav-toggle :global(.nav-toggle-close) {
    display: block;
  }

  /* ── Mobile disclosure ── */
  .nav-mobile {
    max-width: var(--page-max-width);
    margin: 0.5rem auto 0;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-radius: var(--radius-panel);
    border: 1px solid var(--color-hairline);
    background: var(--color-paper);
    box-shadow: 0 18px 48px -20px rgb(11 18 32 / 0.28);
  }
  .nav-mobile[hidden] {
    display: none;
  }
  .nav-mobile-label {
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 0.75rem 0.75rem 0.35rem;
  }
  .nav-mobile-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius-button);
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
  }
  .nav-mobile-link--plain {
    color: var(--color-body);
    font-weight: 500;
  }
  .nav-mobile-link:hover,
  .nav-mobile-link:focus-visible {
    background: var(--color-mist);
  }
  .nav-mobile-rule {
    height: 1px;
    background: var(--color-hairline);
    margin: 0.4rem 0.75rem;
  }
  .nav-mobile-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem 0.4rem;
  }
  .nav-mobile-actions .btn {
    justify-content: center;
  }

  /* ── Desktop breakpoint ── */
  @media (min-width: 1024px) {
    .nav-menu {
      display: flex;
    }
    .nav-login {
      display: inline-flex;
    }
    .nav-toggle {
      display: none;
    }
    .nav-mobile {
      display: none !important;
    }
  }

  @media (max-width: 420px) {
    .nav-brand-text {
      display: none;
    }
  }
</style>

<script>
  // Two jobs: a scrolled-state class on the sticky wrapper, and the mobile
  // disclosure. Desktop dropdowns are pure CSS and need no script.
  const wrap = document.getElementById('site-nav');
  const toggle = wrap?.querySelector('.nav-toggle') as HTMLButtonElement | null;
  const panel = document.getElementById('nav-mobile');

  const onScroll = () => wrap?.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!wrap || !toggle || !panel) return;
    wrap.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  };

  toggle?.addEventListener('click', () => setOpen(panel?.hidden ?? true));
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel?.hidden) {
      setOpen(false);
      toggle?.focus();
    }
  });
  // A resize up into desktop leaves no stranded open panel.
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
