---
/** The fixed 40px lockup slot — DESIGN.md §8.7.
 *
 *  "Logo lockup in a fixed 40px-height slot — the four lockups have four
 *  different aspect ratios and the slot keeps grid rhythm. `alt` carries the
 *  product name so the heading stays crawlable."
 *
 *  Real files now exist at public/platforms/{slug}.png, dropped in at any
 *  aspect ratio without reflow (the box is fixed) — exactly what this slot
 *  was built to accept. `slug` selects the real logo; omit it and this falls
 *  back to the interim typographic wordmark for a platform with no file yet.
 *
 *  No hue treatment on the mark itself — §6's permitted-hue list is exhaustive
 *  and doesn't include it. */
import type { Platform } from '../content/platforms';
interface Props {
  name: string;
  slug?: Platform['slug'];
  /** The slot is the heading, so the caller sets the level. */
  as?: 'h2' | 'h3' | 'h4';
  class?: string;
}
const { name, slug, as: Tag = 'h3', class: cls = '' } = Astro.props;
---

<div class={`lockup ${cls}`}>
  {slug ? (
    <Tag class="lockup-heading">
      <img class="lockup-logo" src={`/platforms/${slug}.png`} alt={name} />
    </Tag>
  ) : (
    <Tag class="lockup-mark">{name}</Tag>
  )}
</div>

<style>
  /* Fixed box. Real lockups drop in at any aspect ratio without reflow. */
  .lockup {
    height: 40px;
    display: flex;
    align-items: center;
  }

  .lockup-heading {
    margin: 0;
    height: 100%;
    display: flex;
    align-items: center;
  }
  .lockup-logo {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }

  .lockup-mark {
    margin: 0;
    font-size: var(--text-h3);
    line-height: 1;
    letter-spacing: -0.022em;
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
