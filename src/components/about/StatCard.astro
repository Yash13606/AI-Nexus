---
/** A single verifiable metric. Paper card + hairline + the sanctioned surface
 *  step on hover (.hov). No count-up — theme.css motion thesis is explicit that
 *  nothing counts up; the figure is a value to be read, present at rest. */
interface Props {
  figure: string;
  label: string;
  sub?: string;
}
const { figure, label, sub } = Astro.props;
---

<div class="stat card hov">
  <p class="stat__figure mono">{figure}</p>
  <p class="stat__label">{label}</p>
  {sub && <p class="stat__sub">{sub}</p>}
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    height: 100%;
  }
  .stat__figure {
    font-size: clamp(2.75rem, 6vw, 3.75rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .stat__label {
    font-size: var(--text-h4);
    line-height: 1.3;
    letter-spacing: -0.012em;
    font-weight: 500;
    color: var(--color-ink);
  }
  .stat__sub {
    font-size: var(--text-body-sm);
    line-height: 1.45;
    color: var(--color-muted);
    margin-top: auto;
  }
</style>
