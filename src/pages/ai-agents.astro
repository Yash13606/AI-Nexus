---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import AgentCard from '../components/AgentCard.astro';
import { platforms } from '../content/platforms';
import { detail } from '../content/platform-detail';
import { governance } from '../content/home';

/** TrustProperty publishes six agents that are not live. They are listed as
 *  not-live rather than omitted — the same discipline as the rest of the site. */
const inDevelopment = [
  { name: 'GharGPT', body: 'Conversational property discovery across the whole marketplace.' },
  { name: 'Negotiation', body: 'Assists both sides through offer and counter-offer.' },
  { name: 'Visit Concierge', body: 'Plans and coordinates multi-property site visits.' },
  { name: 'Agreement Explainer', body: 'Explains a rental or sale agreement clause by clause.' },
  { name: 'Society Copilot', body: "Answers resident questions from the society's own records." },
  { name: 'NRI Advisor', body: 'Guides non-resident buyers through remote purchase and compliance.' },
];
---

<Base
  title="All 48 AI Agents Across Four Platforms | AI Nexus"
  description="48 named AI agents across MedOrbit, Edvation, AdvoHub and TrustProperty. Each is listed with the input a user gives, the output it produces, and the constraint that governs it."
>
  <section class="section" style="padding-block: clamp(2.5rem, 5vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);">
    <div class="shell">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8">
          <Breadcrumbs trail={[{ href: '/', label: 'Home' }, { label: 'AI agents' }]} />
          <h1 class="t-h1" style="max-width: 20ch; font-size: clamp(1.875rem, 4vw, 2.875rem); line-height: 1.06; color: var(--color-navy, #071040);">
            48 AI agents, each with one job and one guardrail
          </h1>
          <div class="sweep-rule mt-5 h-[3px] w-10 rounded-full" style="background: linear-gradient(90deg, var(--color-accent) 0 62%, var(--color-cyan, #00b4ec) 62% 100%);"></div>
          <p class="t-lede mt-5" style="max-width: 54ch; color: var(--color-muted, #4b5464);">
            AI Nexus builds 48 named AI agents across four platforms. Each does a single task someone would
            otherwise do by hand. Every agent below is listed with the input a user gives, the output it
            produces, and the constraint that governs it.
          </p>
          <p class="t-sm mt-4 text-xs" style="color: var(--color-muted, #7a8499);">
            Product examples on this site are illustrative.
          </p>
        </div>

        <div class="lg:col-span-4 grid grid-cols-2 gap-3" aria-label="Agents by platform">
          {platforms.map((p) => (
            <button
              class="stat-tile text-left p-3.5 bg-white border border-line rounded-[10px] relative overflow-hidden transition-all duration-200 hover:-translate-y-0.5 hover:shadow-sm"
              style={`--tile-hue: ${p.hue};`}
              data-platform-filter={p.slug}
            >
              <span class="absolute top-0 left-0 w-1 h-full rounded-l-[10px]" style={`background: ${p.hue};`}></span>
              <div class="font-mono text-2xl font-semibold leading-none" style={`color: ${p.hue};`}>{p.agentCount}</div>
              <div class="text-xs font-medium mt-1" style="color: var(--color-ink-2, #4b5464);">{p.name}</div>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Console Toolbar — Sticky Search & Platform Filter Tabs */}
  <div class="console-toolbar sticky top-[68px] z-40 bg-paper/90 backdrop-blur-md border-y border-hairline py-3" role="search" aria-label="Agent search and filter">
    <div class="shell flex flex-wrap items-center justify-between gap-4">
      <div class="relative flex-1 min-w-[240px] max-w-xs">
        <label for="agent-search" class="sr-only">Find an agent</label>
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          type="search"
          id="agent-search"
          class="w-full h-9 pl-9 pr-8 bg-white border border-line rounded-md text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent"
          placeholder="e.g. voice, denial, citation"
          autocomplete="off"
        />
        <button id="search-clear" class="hidden absolute right-2 top-1/2 -translate-y-1/2 p-1 text-muted hover:text-ink" aria-label="Clear search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="hidden sm:flex items-center gap-1.5 flex-wrap" role="group" aria-label="Filter by platform" id="filter-tabs">
        <button class="filter-tab px-3 py-1.5 rounded-md border text-xs font-medium bg-ink text-white border-ink" aria-pressed="true" data-platform="all">
          All <span class="mono opacity-80 text-[0.7rem]">48</span>
        </button>
        {platforms.map((p) => (
          <button
            class="filter-tab px-3 py-1.5 rounded-md border border-line bg-white text-xs font-medium hover:border-line-strong hover:bg-paper-2 transition-colors"
            aria-pressed="false"
            data-platform={p.slug}
            style={`--tab-hue: ${p.hue};`}
          >
            {p.name} <span class="mono opacity-80 text-[0.7rem]">{p.agentCount}</span>
          </button>
        ))}
      </div>

      <div class="result-count mono text-xs text-muted">
        <strong id="visible-count">48</strong> of 48 agents
      </div>
    </div>
  </div>

  <div id="agents-container">
    {/* Empty State */}
    <div id="empty-state" class="hidden shell py-16 text-center">
      <div class="text-3xl mb-3 opacity-40">🔍</div>
      <p class="font-serif text-lg font-semibold" id="empty-title">No agents match your search</p>
      <p class="text-sm text-muted mt-1" id="empty-sub">Try a shorter phrase or select another platform.</p>
      <button id="empty-clear" class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-accent text-white text-xs font-medium rounded-md hover:bg-accent-deep transition-colors">Clear search</button>
    </div>

    {
      platforms.map((p, i) => (
        <section class={`section platform-section ${i % 2 === 1 ? 'band' : ''}`} id={p.slug} data-platform={p.slug} style="scroll-margin-top: 130px;">
          <div class="shell">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 pb-3 border-l-4 pl-4" style={`border-color: ${p.hue};`}>
              <div class="flex items-baseline gap-3">
                <h2 class="t-h2 font-mono text-sm uppercase tracking-widest" style={`color: ${p.hue};`}>
                  {p.name}
                </h2>
                <span class="text-xs text-muted mono">· {p.agentCount} agents</span>
              </div>
              <a href={`/platforms/${p.slug}/`} class="link-accent group/link text-xs font-medium">
                The {p.name} platform <Icon name="arrow-right" class="arrow" size={12} />
              </a>
            </div>

            <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3 agent-grid">
              {detail[p.slug].agents.map((a) => <AgentCard agent={a} hue={p.hue} />)}
            </div>

            {p.slug === 'trustproperty' && (
              <div class="mt-12 pt-6 border-t border-dashed border-hairline">
                <h3 class="t-h4 font-mono text-xs uppercase tracking-wider text-muted">In development — not live today</h3>
                <div class="mt-4 grid gap-x-8 gap-y-4 sm:grid-cols-2 xl:grid-cols-3">
                  {inDevelopment.map((x) => (
                    <div class="flex flex-col gap-1 pt-3 border-t border-hairline">
                      <p class="t-sm text-sm font-medium" style="color: var(--color-ink);">{x.name}</p>
                      <p class="t-cap text-xs text-muted">{x.body}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </section>
      ))
    }
  </div>

  {/* Governance recap — identical to the homepage and /security/. */}
  <section class="section">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 20ch;">How the AI is governed</h2>
      <p class="t-lede mt-5">
        The same discipline runs through all four platforms. These are controls implemented in the
        software, not commitments in a policy document.
      </p>

      <div class="mt-12 grid gap-x-9 gap-y-8 sm:grid-cols-2 xl:grid-cols-4">
        {
          governance.map((g) => (
            <div class="flex flex-col gap-2 pt-4" style="border-top: 1px solid var(--color-hairline);">
              <h3 class="t-h4">{g.title}</h3>
              <p class="t-sm">{g.body}</p>
            </div>
          ))
        }
      </div>

      <a href="/security/" class="link-accent mt-10 group/link">
        Security, data residency and compliance <Icon name="arrow-right" class="arrow" size={14} />
      </a>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Interactive Search & Platform Filter
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('agent-search') as HTMLInputElement;
    const searchClear = document.getElementById('search-clear');
    const filterTabs = document.querySelectorAll('.filter-tab');
    const visibleCountEl = document.getElementById('visible-count');
    const emptyState = document.getElementById('empty-state');
    const emptyClear = document.getElementById('empty-clear');
    const cards = document.querySelectorAll('.agent-card') as NodeListOf<HTMLElement>;
    const sections = document.querySelectorAll('.platform-section') as NodeListOf<HTMLElement>;
    const statTiles = document.querySelectorAll('[data-platform-filter]');

    let activeQuery = '';
    let activePlatform = 'all';

    function updateFilter() {
      const q = activeQuery.trim().toLowerCase();
      const p = activePlatform;
      let count = 0;

      cards.forEach((card) => {
        const cardPlat = card.closest('.platform-section')?.getAttribute('data-platform');
        const searchTxt = card.getAttribute('data-search-text') || '';
        const matchPlat = p === 'all' || cardPlat === p;
        const matchQ = !q || searchTxt.includes(q);

        if (matchPlat && matchQ) {
          card.style.display = 'flex';
          count++;
        } else {
          card.style.display = 'none';
        }
      });

      sections.forEach((sec) => {
        const visibleInSec = Array.from(sec.querySelectorAll('.agent-card')).some(
          (c) => (c as HTMLElement).style.display !== 'none'
        );
        sec.style.display = visibleInSec ? 'block' : 'none';
      });

      if (visibleCountEl) visibleCountEl.textContent = String(count);

      if (emptyState) {
        if (count === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', () => {
      activeQuery = searchInput.value;
      if (searchClear) searchClear.classList.toggle('hidden', !activeQuery);
      updateFilter();
    });

    searchClear?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeQuery = '';
      searchClear.classList.add('hidden');
      updateFilter();
    });

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => {
          t.setAttribute('aria-pressed', 'false');
          t.classList.remove('bg-ink', 'text-white', 'border-ink');
          t.classList.add('bg-white', 'border-line');
          (t as HTMLElement).style.backgroundColor = '';
          (t as HTMLElement).style.borderColor = '';
          (t as HTMLElement).style.color = '';
        });

        tab.setAttribute('aria-pressed', 'true');
        activePlatform = tab.getAttribute('data-platform') || 'all';

        if (activePlatform === 'all') {
          tab.classList.add('bg-ink', 'text-white', 'border-ink');
        } else {
          const hue = (tab as HTMLElement).style.getPropertyValue('--tab-hue');
          if (hue) {
            (tab as HTMLElement).style.backgroundColor = hue;
            (tab as HTMLElement).style.borderColor = hue;
            (tab as HTMLElement).style.color = '#ffffff';
          }
        }
        updateFilter();
      });
    });

    statTiles.forEach((tile) => {
      tile.addEventListener('click', () => {
        const plat = tile.getAttribute('data-platform-filter');
        if (plat) {
          const targetTab = document.querySelector(`.filter-tab[data-platform="${plat}"]`) as HTMLElement;
          targetTab?.click();
          document.querySelector('.console-toolbar')?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    emptyClear?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeQuery = '';
      searchClear?.classList.add('hidden');
      const allTab = document.querySelector('.filter-tab[data-platform="all"]') as HTMLElement;
      allTab?.click();
    });
  });
</script>

