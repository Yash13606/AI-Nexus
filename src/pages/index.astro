---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import RevealRoot from '../components/ui/RevealRoot.astro';
import ScrollExpand from '../components/react/ScrollExpand';
import GradualBlur from '../components/react/GradualBlur';
import MagicBento from '../components/react/MagicBento';
import ScrollSpread from '../components/react/ScrollSpread';
import { platforms } from '../content/platforms';
import { agents, agentsFor } from '../content/agents';
import { isPlanned } from '../content/site';
import {
  hero, standards, showcase, proof, governance,
  deployment, deploymentCaveat, whyLede, why, roleFamilies, faqs, aboutBlock,
} from '../content/home';
import { entities, contact } from '../content/site';

const agentsPlanned = isPlanned('/ai-agents/');

/** Role-card icon + texture angle, in roleFamilies order (hospitals, schools,
 *  law firms, property) — indexed, not keyed, since the order is fixed. */
const roleIcons = ['cross', 'book', 'scale', 'home'] as const;
const roleAngles = [45, -45, 135, 90];
---

<Base
  title="AI Nexus Innovations Hub — AI Platforms for Health, Education, Law, Property"
  description={hero.lede}
  jsonldFaq
>
  <RevealRoot />

  {/* ══════════════ HERO ══════════════
      An inset card: white where the type sits, blue pooling at the bottom,
      with the product screen breaking the card's lower edge. Everything is
      at final opacity in the HTML — the gradient is the only decoration and
      it is CSS, so there is no image to wait for and nothing to crop. */}
  <section class="relative" style="padding: clamp(0.75rem, 2vw, 1.5rem) clamp(0.75rem, 2vw, 1.5rem) 0;">
    <div class="hero-card">
      <div class="hero-inner">
        <p class="t-label" style="color: var(--color-muted);">{hero.eyebrow}</p>

        <h1 class="t-display mt-6" style="font-weight: 500;">{hero.headline}</h1>

        <p class="t-lede mt-6" style="margin-inline: auto;">{hero.lede}</p>

        <div class="mt-9 flex flex-wrap gap-3 justify-center">
          <a href="/contact/" class="btn btn-primary tx-fast">
            Book a demo <Icon name="arrow-right" class="arrow" />
          </a>
          <a href="#see-it-work" class="btn btn-secondary tx-fast">Watch it work</a>
        </div>

        <p class="t-cap mt-8 mono" style="color: var(--color-muted);">{hero.summary}</p>
      </div>

      {/* React Bits GradualBlur — frosts the streak texture at the card's edge. */}
      <GradualBlur
        client:visible
        target="parent"
        position="bottom"
        height="7rem"
        strength={2}
        divCount={5}
        curve="bezier"
        exponential
        opacity={1}
      />
    </div>
  </section>

  {/* ══════════════ SCROLL EXPAND ══════════════
      React Bits ScrollExpand on window scroll: the frame opens from an inset
      rect to full bleed while the media counter-zooms back to 1. The overlay
      copy is duplicated in a visually-hidden block below so the section is
      still readable to a crawler while the overlay sits at opacity 0. */}
  <section aria-label="What the platforms do">
    <ScrollExpand
      client:load
      src="/screen-placeholder.svg"
      alt="AI Nexus platform interface"
      title="Four platforms. One discipline."
      scrollHint="Scroll to open"
      useWindowScroll
      startWidth={46}
      startHeight={58}
      startRadius={24}
      endRadius={0}
      mediaZoom={1.25}
      scrollDistance={1.1}
      holdDistance={0.3}
      smoothing={0.1}
      overlayScrim={0.5}
    >
      <h2 class="t-h2" style="color: #fff; max-width: 22ch;">Every answer shows its source.</h2>
      <p class="t-lede mt-4" style="color: rgb(255 255 255 / 0.86); margin-inline: auto;">
        Page citations in education. Indian Kanoon verification in law. Chart-grounded outputs in
        health. Explainable scores in property.
      </p>
    </ScrollExpand>

    <p class="sr-only">
      Every answer shows its source. Page citations in education. Indian Kanoon verification in law.
      Chart-grounded outputs in health. Explainable scores in property.
    </p>
  </section>

  {/* ══════════════ SEE IT WORK — four platforms, scroll-spread ══════════════
      ScrollSpread: GSAP ScrollTrigger pins the section and spreads four
      paper cards from a centre stack as the user scrolls. Minimal card
      content per brief: name, sector, agent count, headline. Evidence triad
      stays in the HTML (sr-only list) so crawlers still see it. */}
  <section id="see-it-work" style="background: var(--color-wash);">
    <div class="shell pt-16 pb-4">
      <p class="t-label" style="color: var(--color-accent);">{showcase.kicker}</p>
      <h2 class="t-h2 mt-4" style="max-width: 30ch;">{showcase.heading}</h2>
    </div>

    <ScrollSpread client:load />

    {/* Evidence triad for crawlers — hidden visually, always in DOM */}
    <ul class="sr-only">
      {platforms.map((p) => (
        <li>
          {p.name} ({p.sector}): {p.headline}.
          Input: {p.evidence.input}
          Output: {p.evidence.output}
          Control: {p.evidence.control}
        </li>
      ))}
    </ul>
  </section>

  {/* ══════════════ PROOF — React Bits MagicBento ══════════════
      Upstream logic, retinted: paper cards, hairline borders, ink text and a
      Nexus Indigo glow in place of the stock #120F17 / #8400ff purple. The
      card copy is duplicated as a visually-hidden list because the grid is
      client-rendered and the figures must still reach a crawler. */}
  <section class="section" id="proof">
    <div class="shell">
      <p class="t-label" style="color: var(--color-accent);">{proof.kicker}</p>
      <h2 class="t-h2 mt-4" style="max-width: 20ch;">{proof.heading}</h2>

      <div class="mt-10">
        <MagicBento
          client:visible
          textAutoHide={false}
          enableStars
          enableSpotlight
          enableBorderGlow
          enableTilt={false}
          enableMagnetism={false}
          clickEffect
          spotlightRadius={400}
          particleCount={10}
          glowColor="43, 70, 212"
        />
      </div>

      <ul class="sr-only">
        <li>{proof.lead.figure} {proof.lead.label}. {proof.lead.body}</li>
        {proof.tiles.map((t) => <li>{t.figure} — {t.label}</li>)}
      </ul>

      {/* Compliance Chip Row — DESIGN.md §8.15 exactly: a flat wrapping row
          of pills with the mandatory disclaimer above. Not a bordered
          panel — the badge-wall anti-reference this line exists to refute
          shouldn't itself arrive with more chrome than a paragraph gets. */}
      <div class="mt-8">
        <p class="t-cap" style="color: var(--color-muted);">
          Capability statements, not certification logos. Certificates are published only when they exist.
        </p>
        <ul class="mt-3 flex flex-wrap gap-2 list-none m-0 p-0">
          {standards.map((s) => (
            <li class="standards-chip mono tx-fast">{s}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ══════════════ WHAT EACH PLATFORM DOES ══════════════
      Sticky-scroll reveal: the worked-example proof (timeline + evidence)
      stays pinned while the text scrolls through all four platforms, swapping
      to match whichever one is centered. Below 1024px there's no room for a
      pinned side panel, so each platform's evidence renders inline instead,
      right after its own text — nothing drops on mobile, it just stops being
      sticky. */}
  <section class="section">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 20ch;">What each platform actually does</h2>
      <p class="t-lede mt-5">
        Every platform below ships with a worked example: the input a real user gives, the output the
        agent produces, and the guardrail that constrains it.
      </p>

      <nav aria-label="Jump to a platform" class="mt-7 flex flex-wrap gap-2">
        {platforms.map((p) => (
          <a
            href={`#${p.slug}`}
            class="hov t-sm no-underline inline-flex items-center rounded-[999px] px-4 py-2"
            style="border: 1px solid var(--color-hairline); color: var(--color-body);"
          >
            {p.name}
          </a>
        ))}
      </nav>
    </div>

    <div class="shell" style="margin-top: clamp(3rem, 6vw, 5rem);">
      <div class="ssr">
        <div class="ssr-list">
          {platforms.map((p, idx) => (
            <div id={p.slug} class="ssr-item" style="scroll-margin-top: 88px;" data-ssr-index={idx} data-reveal>
              <div class="flex items-center gap-3">
                <span class="mono t-cap shrink-0" style="color: var(--color-muted);" aria-hidden="true">
                  {String(idx + 1).padStart(2, '0')}
                </span>
                <span class="shrink-0" style="height: 28px; display: flex; align-items: center;">
                  <img
                    src={`/platforms/${p.slug}.png`}
                    alt=""
                    style="height: 100%; width: auto; max-width: 120px; object-fit: contain;"
                  />
                </span>
                <p class="t-label m-0" style={`color: ${p.hue};`}>{p.name} · {p.sector}</p>
              </div>
              <h3 class="t-h2 mt-3">{p.headline}</h3>
              <p class="t-lede mt-5">{p.body}</p>

              <div class="mt-9 flex flex-col gap-7">
                {p.features.map((f) => (
                  <div class="flex flex-col gap-2">
                    <h4 class="t-h4">{f.title}</h4>
                    <p class="t-sm prose">{f.body}</p>
                  </div>
                ))}
              </div>

              <dl class="mt-9 grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-5 m-0">
                {p.stats.map((s) => (
                  <div class="flex flex-col gap-1" style="border-top: 1px solid var(--color-hairline); padding-top: 0.75rem;">
                    {/* A count and a region string are not the same kind of value.
                        'ap-south-1' at h3 overflows a 2-col grid at 320px. */}
                    <dd
                      class="m-0 mono"
                      style={`color: var(--color-ink); font-weight: 500; overflow-wrap: anywhere; ${
                        s.figure.length > 4
                          ? 'font-size: var(--text-h4); line-height: 1.3;'
                          : 'font-size: var(--text-h3); line-height: 1.2; letter-spacing: -0.018em;'
                      }`}
                    >
                      {s.figure}
                    </dd>
                    <dt class="t-cap" style="color: var(--color-muted);">{s.label}</dt>
                  </div>
                ))}
              </dl>

              <div class="mt-9 flex flex-wrap gap-3">
                <a href={`/platforms/${p.slug}/`} class="btn btn-primary tx-fast">
                  Explore {p.name} <Icon name="arrow-right" class="arrow" />
                </a>
                <a href={p.site} target="_blank" rel="noopener" class="btn btn-secondary tx-fast">
                  Visit {p.site.replace('https://www.', '')} <Icon name="arrow-up-right" size={14} />
                </a>
              </div>

              {/* Rail is hidden below 1024px — this is the proof's only home there. */}
              <div class="ssr-mobile-evidence">
                <EvidenceCard evidence={p.evidence} />
              </div>
            </div>
          ))}
        </div>

        <div class="ssr-rail">
          <div class="ssr-sticky">
            {platforms.map((p, idx) => (
              <div class="ssr-visual" data-ssr-panel={idx} {...(idx === 0 ? { 'data-active': '' } : {})}>
                <div class="card p-6">
                  <p class="t-cap m-0 mb-4" style="color: var(--color-muted);">{p.panel.title}</p>
                  {p.panel.rows.map((r, i) => (
                    <div
                      class="flex gap-4 items-baseline py-3"
                      style={`border-top: ${i > 0 ? '1px' : '0'} solid var(--color-hairline);`}
                    >
                      <span class="mono t-cap shrink-0" style="color: var(--color-muted); width: 62px;">{r.when}</span>
                      <span class="t-sm flex-1" style="color: var(--color-ink);">{r.what}</span>
                      <span class="t-cap text-right" style="color: var(--color-muted);">{r.outcome}</span>
                    </div>
                  ))}
                  <p class="t-cap italic mt-4 m-0" style="color: var(--color-muted);">{p.panel.note}</p>
                </div>

                <EvidenceCard evidence={p.evidence} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ══════════════ 48 AGENTS ══════════════
      /ai-agents/ is not built yet, so names render as text rather than dead
      anchors. All 48 stay in the HTML — only the links are withheld. */}
  <section class="section band">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 20ch;">48 AI agents, each with one job</h2>
      <p class="t-lede mt-5">
        Not one assistant with many prompts. Each agent does a single task someone would otherwise do by
        hand, and each carries its own guardrails, its own audit trail and its own cost ceiling.
      </p>

      <div class="mt-12 grid gap-10 md:grid-cols-2 xl:grid-cols-4">
        {platforms.map((p) => (
          <div>
            <div class="flex items-baseline justify-between gap-3 pb-2.5" style={`border-bottom: 2px solid ${p.hue};`}>
              <p class="t-label" style={`color: ${p.hue};`}>{p.name}</p>
              <p class="t-cap mono" style="color: var(--color-muted);">{p.agentCount} agents</p>
            </div>
            <ul class="list-none m-0 p-0">
              {agentsFor(p.slug).map((a) => (
                <li class="py-3" style="border-bottom: 1px solid var(--color-hairline);">
                  {agentsPlanned ? (
                    <span class="t-sm font-medium block" style="color: var(--color-ink);">{a.name}</span>
                  ) : (
                    <a href={`/ai-agents/#${a.slug}`} class="t-sm font-medium block no-underline" style="color: var(--color-ink);">
                      {a.name}
                    </a>
                  )}
                  <span class="t-cap block mt-0.5" style="color: var(--color-muted);">{a.summary}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ══════════════ GOVERNANCE ══════════════ */}
  <section class="section">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 20ch;">How the AI is governed</h2>
      <p class="t-lede mt-5">
        The same discipline runs through all four platforms. These are controls implemented in the
        software, not commitments in a policy document.
      </p>

      <div class="mt-12 grid gap-x-9 gap-y-8 sm:grid-cols-2 xl:grid-cols-4">
        {governance.map((g) => (
          <div class="flex flex-col gap-2 pt-4" style="border-top: 1px solid var(--color-hairline);">
            <h3 class="t-h4">{g.title}</h3>
            <p class="t-sm">{g.body}</p>
          </div>
        ))}
      </div>

      <p class="t-sm mt-10" style="color: var(--color-muted);">
        Security, data residency and compliance — page in progress.
      </p>
    </div>
  </section>

  {/* ══════════════ DEPLOYMENT ══════════════
      Numbered because this genuinely is a sequence — a connected rail of
      steps, click (or arrow-key) any node to bring its panel forward. */}
  <section class="section band">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 20ch;">How a deployment works</h2>
      <p class="t-lede mt-5">The same four steps for every platform.</p>

      <div id="deployment-tabs" class="hiw mt-14">
        <div role="tablist" aria-label="Deployment steps" class="hiw-rail">
          {deployment.map((d, i) => (
            <button
              type="button"
              role="tab"
              id={`hiw-tab-${i}`}
              aria-controls={`hiw-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="hiw-node"
            >
              <span class="hiw-node-circle mono">{d.n}</span>
              <span class="hiw-node-title">{d.title}</span>
            </button>
          ))}
        </div>

        <div class="mt-10" style="max-width: var(--prose-max-width);">
          {deployment.map((d, i) => (
            <div role="tabpanel" id={`hiw-panel-${i}`} aria-labelledby={`hiw-tab-${i}`} tabindex="0" class="hiw-panel">
              <p class="t-cap mono" style="color: var(--color-muted);">{d.n}</p>
              <h3 class="t-h3 mt-2">{d.title}</h3>
              <p class="t-body mt-3">{d.body}</p>
            </div>
          ))}
        </div>
      </div>

      <p class="t-sm mt-9 prose" style="color: var(--color-muted);">{deploymentCaveat}</p>
    </div>
  </section>

  {/* ══════════════ WHY ══════════════ */}
  <section class="section">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 20ch;">Why institutions choose AI Nexus</h2>
      <p class="t-lede mt-5">{whyLede}</p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {why.map((w) => (
          <div class="feat-card">
            <div class="feat-card-head">
              <h3 class="t-h4">{w.title}</h3>
              <p class="t-sm mt-2.5" style="color: var(--color-muted);">{w.body}</p>
            </div>

            <div class="feat-card-panel">
              <div class="flex items-center gap-1.5 t-cap" style="color: var(--color-muted);">
                <Icon name={w.icon} size={14} />
                {w.panelLabel}
              </div>

              <div>
                <p class="glow-card-stat mono">{w.stat}</p>
                <p class="t-cap mt-1" style="color: var(--color-muted);">{w.unit}</p>
              </div>

              <div class="flex flex-col">
                {w.rows.map((row) => (
                  <p class="feat-card-row t-cap">{row}</p>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ══════════════ ROLE FAMILIES ══════════════ */}
  <section class="section band">
    <div class="shell">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <h2 class="t-h2" style="max-width: 20ch;">Built for every seat</h2>
          <p class="t-lede mt-5">
            A doctor, a teacher, an intern and a property owner need different things from the same platform.
            Each product ships role-specific views, and the audit log records who saw what.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:col-span-7">
          {roleFamilies.map((r, idx) => {
            const stat = r.meta.match(/^\d+/)?.[0] ?? '';
            const unit = r.meta.replace(/^\d+\s*/, '');
            return (
              <a href={r.href} class="glow-card no-underline" style={`--glow-color: color-mix(in oklab, ${r.hue} 55%, transparent);`} data-glow-card>
                <span
                  class="glow-card-texture"
                  aria-hidden="true"
                  style={`background-image: repeating-linear-gradient(${roleAngles[idx]}deg, color-mix(in oklab, ${r.hue} 10%, transparent), color-mix(in oklab, ${r.hue} 10%, transparent) 10px, transparent 10px, transparent 22px);`}
                />
                <div class="glow-card-inner flex flex-col gap-5 p-6">
                  <div class="glow-card-icon" style={`color: ${r.hue};`} aria-hidden="true">
                    <Icon name={roleIcons[idx]} size={18} />
                  </div>

                  <div>
                    <p class="glow-card-stat mono" aria-hidden="true">
                      {stat}<span class="glow-card-stat-unit">{unit}</span>
                    </p>
                    <h3 class="t-h4 mt-2">{r.title}</h3>
                  </div>

                  <p class="t-sm flex-1" style="color: var(--color-muted);">{r.body}</p>
                  <span class="t-cap mono" style="color: var(--color-muted);">{r.meta}</span>
                  <span class="link-accent">
                    Explore <Icon name="arrow-right" class="arrow" size={14} />
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  {/* ══════════════ FAQ — native <details>, zero JS ══════════════ */}
  <section class="section">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 20ch;">Frequently asked questions</h2>
      <div class="faq mt-10">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>
              {f.q}
              <Icon name="chevron-down" class="chev" size={18} />
            </summary>
            <p class="answer t-body">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ══════════════ ABOUT ══════════════ */}
  <section class="section band">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 22ch;">A product company for the institutions that matter most</h2>
      <div class="mt-8 flex flex-col gap-5 prose">
        {aboutBlock.map((para) => <p class="t-body">{para}</p>)}
      </div>
      <p class="t-sm mt-8" style="color: var(--color-muted);">
        Founded and led by Geetha R, Founder &amp; Director.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 max-w-[720px]">
        {entities.map((e) => (
          <div class="card p-5 flex flex-col gap-1.5">
            <p class="t-label" style="color: var(--color-muted);">{e.region}</p>
            <p class="t-sm font-medium" style="color: var(--color-ink);">{e.name}</p>
            <p class="t-cap mono" style="color: var(--color-muted);">{e.id} · {e.place}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ══════════════ CTA — the one centred block ══════════════ */}
  <section class="section" style="background: var(--color-wash);">
    <div class="shell text-center flex flex-col items-center gap-5">
      <h2 class="t-h2">See a platform in action.</h2>
      <p class="t-lede" style="margin-inline: auto;">
        A 30-minute demo of any platform, run on your own facility type, board, practice area or city —
        or a conversation about partnership. We reply within one business day.
      </p>
      <div class="mt-3 flex flex-wrap gap-3 justify-center">
        <a href="/contact/" class="btn btn-primary tx-fast">
          Book a demo <Icon name="arrow-right" class="arrow" />
        </a>
        <a href={contact.linkedin} target="_blank" rel="noopener" class="btn btn-secondary tx-fast">
          Connect on LinkedIn <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>
  </section>

</Base>

<script>
  import { initReveal } from '../scripts/reveal.js';
  import { initGlowCards } from '../scripts/glow-cards.js';
  import { initTabs } from '../scripts/tabs.js';
  initReveal();
  initGlowCards();

  const deploymentTabs = document.getElementById('deployment-tabs');
  if (deploymentTabs) initTabs(deploymentTabs);

  // Sticky-scroll reveal: swap the pinned worked-example panel to match
  // whichever platform's text block is centered in the viewport.
  const ssrItems = document.querySelectorAll('.ssr-item');
  const ssrPanels = document.querySelectorAll('.ssr-visual');
  if (ssrItems.length && ssrPanels.length) {
    const setActive = (index) => {
      ssrPanels.forEach((panel) => {
        panel.toggleAttribute('data-active', Number(panel.dataset.ssrPanel) === index);
      });
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(Number(entry.target.dataset.ssrIndex));
        });
      },
      { rootMargin: '-45% 0px -45% 0px' }
    );
    ssrItems.forEach((el) => io.observe(el));
  }
</script>
