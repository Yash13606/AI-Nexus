---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import StickyContentWrapper from '../components/react/StickyContentWrapper.tsx';
import PlatformPanelBody from '../components/PlatformPanelBody.astro';
import RevealRoot from '../components/ui/RevealRoot.astro';
import ScrollExpand from '../components/react/ScrollExpand';
import GradualBlur from '../components/react/GradualBlur';
import MagicBento from '../components/react/MagicBento';
import ScrollSpread from '../components/react/ScrollSpread';
import GovernanceShaderCards from '../components/react/GovernanceShaderCards';
import { platforms } from '../content/platforms';
import { agents, agentsFor } from '../content/agents';
import { isPlanned } from '../content/site';
import {
  hero, standards, showcase, proof,
  deployment, deploymentCaveat, why, roleFamilies, faqs,
} from '../content/home';
import { contact } from '../content/site';

/** The Sticky Content Wrapper below passes four STATIC named slots, because
 *  Astro cannot build them in a loop (see the note at the call site). Four
 *  slots and five platforms would drop one silently, so make it loud. */
if (platforms.length !== 4) {
  throw new Error(
    `index.astro renders exactly 4 sticky panels; content/platforms.ts has ${platforms.length}. ` +
      'Add or remove a <PlatformPanelBody slot="body-N"> to match.'
  );
}

const agentsPlanned = isPlanned('/ai-agents/');

/** ── The deployment arc ────────────────────────────────────────────────────
 *  A quarter circle centred on the figure's BOTTOM-RIGHT CORNER, so the band
 *  is concave toward that corner: it comes in through the right edge, sweeps
 *  down and to the left, and leaves through the bottom edge. Both ends are cut
 *  by the section rather than stopping in view. Geometry is resolved HERE
 *  rather than in CSS or at runtime — the node positions and the path have to
 *  come from the same circle or the buttons drift off the line, and one
 *  function guarantees they cannot.
 *
 *  THE SVG DOES NOT PRESERVE ITS ASPECT RATIO, which is what lets the figure
 *  be any shape the layout wants — full bleed to the window's edge, height set
 *  by the section — while a node's `left: 45.5%` still lands exactly on the
 *  line, because under preserveAspectRatio="none" a viewBox unit is one
 *  fraction of the box in each axis independently.
 *
 *  The viewBox is nevertheless shaped close to the box it renders into (760 x
 *  620 against ~724 x 580 at 1440). The stretch is what distorts the stroke,
 *  and keeping the two shapes near each other keeps that under a few percent.
 *  vector-effect="non-scaling-stroke" would remove the distortion outright but
 *  cannot be used here: it puts the dash pattern in screen units while
 *  pathLength="1" declares the path one unit long, so the dashes repeat and
 *  both the fill and the travelling head break into a row of blobs.
 *
 *  TWO PATHS, deliberately. The functional one runs node 01 to node 04 and is
 *  what --hiw-progress fills, so progress 0 and 1 are exactly the first and
 *  last node. The decorative one carries on past both ends and is cut by the
 *  section's edges — the reference's corner-to-corner sweep, without giving the
 *  fill a stretch of line that corresponds to no step. */
const ARC = { w: 760, h: 940, cx: 760, cy: 940, r: 620, from: 262, to: 198, bleed: 20 };
const arcPoint = (deg: number) => ({
  x: ARC.cx + ARC.r * Math.cos((deg * Math.PI) / 180),
  y: ARC.cy + ARC.r * Math.sin((deg * Math.PI) / 180),
});
/** Sweep flag 0: angles decrease, and in SVG's y-down space that is the
 *  counter-clockwise direction — the short way round through the left bulge
 *  rather than the long way round the right. Large-arc 0 while the span < 180°. */
const arcPath = (from: number, to: number) => {
  const a = arcPoint(from);
  const b = arcPoint(to);
  return `M ${a.x.toFixed(2)} ${a.y.toFixed(2)} A ${ARC.r} ${ARC.r} 0 0 0 ${b.x.toFixed(2)} ${b.y.toFixed(2)}`;
};
const arcNodes = deployment.map((d, i) => {
  const at = i / (deployment.length - 1);
  const deg = ARC.from + (ARC.to - ARC.from) * at;
  const { x, y } = arcPoint(deg);
  /** `at` is where this node sits along the path as a 0..1 fraction — the same
   *  scale --hiw-progress runs on, which is what lets CSS reveal each node as
   *  the fill reaches it without a line of JavaScript per node. */
  return { ...d, xPct: (x / ARC.w) * 100, yPct: (y / ARC.h) * 100, at };
});
const arcStepPath = arcPath(ARC.from, ARC.to);
const arcBleedPath = arcPath(ARC.from + ARC.bleed, ARC.to - ARC.bleed);

/** Role-card icon + texture angle, in roleFamilies order (hospitals, schools,
 *  law firms, property) — indexed, not keyed, since the order is fixed. */
const roleIcons = ['cross', 'book', 'scale', 'home'] as const;
const roleAngles = [45, -45, 135, 90];

/** The platform whose agent day runs on the phone in the closing CTA.
 *  MedOrbit: the most modules, so its stat pair reads strongest at that size. */
const ctaPlatform = platforms[0];

/** Agents listed per platform column before the "view more" disclosure.
 *  Four keeps the four columns the same height regardless of whether a
 *  platform ships 7 agents or 20. */
const AGENTS_SHOWN = 4;
---

<Base
  title="AI Nexus Innovations Hub: AI Platforms for Health, Education, Law, Property"
  description={hero.lede}
  jsonldFaq
>
  <RevealRoot />

  {/* ══════════════ HERO ══════════════
      An inset card: white where the type sits, blue pooling at the bottom,
      with the product screen breaking the card's lower edge. Everything is
      at final opacity in the HTML — the gradient is the only decoration and
      it is CSS, so there is no image to wait for and nothing to crop. */}
  <section class="relative" style="padding: clamp(0.75rem, 2vw, 1.5rem) clamp(0.75rem, 2vw, 1.5rem) 0;">
    <div class="hero-card">
      <div class="hero-inner">
        <p class="t-label" style="color: var(--color-muted);">{hero.eyebrow}</p>

        <h1 class="t-display mt-6" style="font-weight: 500;">{hero.headline}</h1>

        <p class="t-lede mt-6" style="margin-inline: auto;">{hero.lede}</p>

        <div class="mt-9 flex flex-wrap gap-3 justify-center">
          <a href="/contact/" class="btn btn-primary tx-fast">
            Book a demo <Icon name="arrow-right" class="arrow" />
          </a>
          <a href="#see-it-work" class="btn btn-secondary tx-fast">Watch it work</a>
        </div>

        <p class="t-cap mt-8 mono" style="color: var(--color-muted);">{hero.summary}</p>
      </div>

      {/* React Bits GradualBlur — frosts the streak texture at the card's edge. */}
      <GradualBlur
        client:visible
        target="parent"
        position="bottom"
        height="7rem"
        strength={2}
        divCount={5}
        curve="bezier"
        exponential
        opacity={1}
      />
    </div>
  </section>

  {/* ══════════════ SCROLL EXPAND ══════════════
      React Bits ScrollExpand on window scroll: the frame opens from an inset
      rect to full bleed while the media counter-zooms back to 1. The overlay
      copy is duplicated in a visually-hidden block below so the section is
      still readable to a crawler while the overlay sits at opacity 0. */}
  <section aria-label="What the platforms do">
    <ScrollExpand
      client:load
      src="/screen-placeholder.svg"
      alt="AI Nexus platform interface"
      title="Four platforms. One discipline."
      scrollHint="Scroll to open"
      useWindowScroll
      startWidth={46}
      startHeight={58}
      startRadius={24}
      endRadius={0}
      mediaZoom={1.25}
      scrollDistance={1.1}
      holdDistance={0.3}
      smoothing={0.1}
      overlayScrim={0.5}
    >
      <h2 class="t-h2" style="color: #fff; max-width: 22ch;">Every answer shows its source.</h2>
      <p class="t-lede mt-4" style="color: rgb(255 255 255 / 0.86); margin-inline: auto;">
        Page citations in education. Indian Kanoon verification in law. Chart-grounded outputs in
        health. Explainable scores in property.
      </p>
    </ScrollExpand>

    <p class="sr-only">
      Every answer shows its source. Page citations in education. Indian Kanoon verification in law.
      Chart-grounded outputs in health. Explainable scores in property.
    </p>
  </section>

  {/* ══════════════ SEE IT WORK — four platforms, scroll-spread ══════════════
      ScrollSpread: GSAP ScrollTrigger pins the section and spreads four
      paper cards from a centre stack as the user scrolls. Minimal card
      content per brief: name, sector, agent count, headline. Evidence triad
      stays in the HTML (sr-only list) so crawlers still see it. */}
  <section id="see-it-work" style="background: var(--color-wash);">
    <div class="shell pt-16 pb-4">
      <p class="t-label" style="color: var(--color-accent);">{showcase.kicker}</p>
      <h2 class="t-h2 mt-4" style="max-width: 30ch;">{showcase.heading}</h2>
    </div>

    <ScrollSpread client:load />

    {/* Evidence triad for crawlers — hidden visually, always in DOM */}
    <ul class="sr-only">
      {platforms.map((p) => (
        <li>
          {p.name} ({p.sector}): {p.headline}.
          Input: {p.evidence.input}
          Output: {p.evidence.output}
          Control: {p.evidence.control}
        </li>
      ))}
    </ul>
  </section>

  {/* ══════════════ PROOF — React Bits MagicBento ══════════════
      Upstream logic, retinted: paper cards, hairline borders, ink text and a
      Nexus Indigo glow in place of the stock #120F17 / #8400ff purple. The
      card copy is duplicated as a visually-hidden list because the grid is
      client-rendered and the figures must still reach a crawler. */}
  <section class="section" id="proof">
    <div class="shell">
      <p class="t-label" style="color: var(--color-accent);">{proof.kicker}</p>
      <h2 class="t-h2 mt-4" style="max-width: 20ch;">{proof.heading}</h2>

      <div class="mt-10">
        <MagicBento
          client:visible
          textAutoHide={false}
          enableStars
          enableSpotlight
          enableBorderGlow
          enableTilt={false}
          enableMagnetism={false}
          clickEffect
          spotlightRadius={400}
          particleCount={10}
          glowColor="43, 70, 212"
        />
      </div>

      <ul class="sr-only">
        <li>{proof.lead.figure} {proof.lead.label}. {proof.lead.body}</li>
        {proof.tiles.map((t) => <li>{t.figure}: {t.label}</li>)}
      </ul>

      {/* Compliance Chip Row — DESIGN.md §8.15 exactly: a flat wrapping row
          of pills with the mandatory disclaimer above. Not a bordered
          panel — the badge-wall anti-reference this line exists to refute
          shouldn't itself arrive with more chrome than a paragraph gets. */}
      <div class="mt-8">
        <p class="t-cap" style="color: var(--color-muted);">
          Capability statements, not certification logos. Certificates are published only when they exist.
        </p>
        <ul class="mt-3 flex flex-wrap gap-2 list-none m-0 p-0">
          {standards.map((s) => (
            <li class="standards-chip mono tx-fast">{s}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ══════════════ WHAT EACH PLATFORM DOES ══════════════
      One platform holds the screen while the next scrolls in behind it —
      copy and worked example on the left, the platform's glass tile on the
      right. Native `position: sticky` inside an N × 100vh track (the
      Hyperiux sticky-content-wrapper structure); GSAP only scrubs the
      crossfade. Content per platform is deliberately short: identity row,
      headline, one sentence, the worked example. The features list, stat
      grid and timeline rows that used to bloat this section live on each
      platform's own page already.
      No JS / reduced motion / narrow / short / printing: plain stacked
      list, same content, no overlay — see platform-pin.js and the
      [data-pinned] gate in theme.css. */}
  <section class="section scw-section">

    {/* The Sticky Content Wrapper (Hyperiux Vault), driving the four worked
        examples. `client:visible` so the island — React, GSAP/ScrollTrigger
        and Lenis — is only fetched once a reader has scrolled this far, and
        never at all on a page they leave before reaching it.

        The bodies are rendered HERE, by Astro, and passed in as named slots:
        each one contains a real EvidenceCard, the site's most-used component
        at ~60 instances. Re-implementing that card inside the React component
        would give it a second definition to drift from. */}
    {/* The Sticky Content Wrapper (Hyperiux Vault), driving the four worked
        examples. `client:visible` so the island — React, GSAP/ScrollTrigger and
        Lenis — is fetched only once a reader scrolls this far, and never at all
        for someone who leaves before reaching it.

        FOUR STATIC SLOTS, not a map. Astro hoists named-slot content into its
        own render function, so a `slot={`body-${idx}`}` built inside a `.map`
        does not close over `idx` and the build fails outright. The assertion in
        the frontmatter turns a fifth platform into a build error rather than a
        panel that silently never renders. */}
    <StickyContentWrapper
      client:visible
      items={platforms.map((p) => ({ image: `/platforms/scw-${p.slug}.svg`, alt: '' }))}
    >
      <PlatformPanelBody slot="body-0" platform={platforms[0]} index={0} />
      <PlatformPanelBody slot="body-1" platform={platforms[1]} index={1} />
      <PlatformPanelBody slot="body-2" platform={platforms[2]} index={2} />
      <PlatformPanelBody slot="body-3" platform={platforms[3]} index={3} />
    </StickyContentWrapper>
  </section>

  {/* ══════════════ 48 AGENTS ══════════════
      /ai-agents/ is not built yet, so names render as text rather than dead
      anchors. All 48 stay in the HTML — only the links are withheld.

      Each column shows four and puts the rest behind a native <details>,
      same zero-JS mechanism as the FAQ. Edvation alone has 20, which ran
      the section far past a screen. Collapsed, not removed: the remaining
      agents are in the markup either way, so a crawler and a JS-off reader
      still get all 48 — <details> only changes whether they are painted. */}
  <section class="section band">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 20ch;">48 AI agents, each with one job</h2>
      <p class="t-lede mt-5">
        Not one assistant with many prompts. Each agent does a single task someone would otherwise do by
        hand, and each carries its own guardrails, its own audit trail and its own cost ceiling.
      </p>

      <div class="mt-12 grid gap-10 md:grid-cols-2 xl:grid-cols-4">
        {platforms.map((p) => {
          const list = agentsFor(p.slug);
          const shown = list.slice(0, AGENTS_SHOWN);
          const rest = list.slice(AGENTS_SHOWN);
          const row = (a: (typeof list)[number]) => (
            <li class="py-3" style="border-bottom: 1px solid var(--color-hairline);">
              {agentsPlanned ? (
                <span class="t-sm font-medium block" style="color: var(--color-ink);">{a.name}</span>
              ) : (
                <a href={`/ai-agents/#${a.slug}`} class="t-sm font-medium block no-underline" style="color: var(--color-ink);">
                  {a.name}
                </a>
              )}
              <span class="t-cap block mt-0.5" style="color: var(--color-muted);">{a.summary}</span>
            </li>
          );
          return (
            <div>
              <div class="flex items-baseline justify-between gap-3 pb-2.5" style={`border-bottom: 2px solid ${p.hue};`}>
                <p class="t-label" style={`color: ${p.hue};`}>{p.name}</p>
                <p class="t-cap mono" style="color: var(--color-muted);">{p.agentCount} agents</p>
              </div>

              <ul class="list-none m-0 p-0">{shown.map(row)}</ul>

              {rest.length > 0 && (
                <details class="agent-more">
                  <summary class="agent-more__toggle" style={`--hue: ${p.hue};`}>
                    <span class="agent-more__label" data-more={`View ${rest.length} more`} data-less="Show fewer"></span>
                    <Icon name="chevron-down" size={14} class="agent-more__chev" />
                  </summary>
                  <ul class="list-none m-0 p-0">{rest.map(row)}</ul>
                </details>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* ══════════════ GOVERNANCE ══════════════ */}
  <section class="section">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 20ch;">How the AI is governed</h2>
      <p class="t-lede mt-5">
        The same discipline runs through all four platforms. These are controls implemented in the
        software, not commitments in a policy document.
      </p>

      <div class="mt-12">
        <GovernanceShaderCards client:visible />
      </div>

      <p class="t-sm mt-10" style="color: var(--color-muted);">
        Security, data residency and compliance: page in progress.
      </p>
    </div>
  </section>

  {/* ══════════════ DEPLOYMENT ══════════════
      Numbered because this genuinely is a sequence — a connected rail of
      steps, click (or arrow-key) any node to bring its panel forward. */}
  <section class="section band hiw-section">
    {/* Pinned for four screens of scroll, one per step. The whole block goes
        with it — heading, rail, panel and caveat — so the step you are on
        changes while everything that explains it stays put.

        The track is the scroll budget; the sticky child is what you see. CSS
        gives it neither height nor stickiness until initStepScroll sets
        data-step-scroll, so JS off, reduced motion, a narrow screen or a short
        window all leave a plain tablist in normal flow. */}
    <div class="hiw-track" style={`--hiw-steps: ${deployment.length};`}>
      <div class="hiw-stick">
        <div class="shell">
      {/* One grid, two columns. Everything you READ is on the left — heading,
          the step's own copy, the caveat — and the arc that shows where you are
          is on the right, which is the reference layout.

          DOM order is heading -> tablist -> panels, so a screen reader meets
          the tabs before the panel they control and a crawler meets the
          heading first. The grid does the placing; nothing here depends on
          source order. */}
      <div id="deployment-tabs" class="hiw hiw-grid">
        <div class="hiw-head">
          <h2 class="t-h2" style="max-width: 20ch;">How a deployment works</h2>
          <p class="t-lede mt-4">The same four steps for every platform.</p>
        </div>

        {/* ── The arc ──────────────────────────────────────────────────────
            An SVG for the line and HTML buttons for the steps, sharing one
            circle: the path and every node position come from the same
            frontmatter geometry, so a button cannot drift off the line.

            Three strokes on one path. The track is the unlit line; the fill is
            scrubbed by --hiw-progress through stroke-dashoffset (pathLength=1
            makes that a plain 0..1, independent of how long the arc actually
            is); the head is a 0.004-long round-capped dash at the same offset,
            which reads as a dot travelling the curve. The dash trick rather
            than offset-path because it needs no motion-path support and cannot
            land at 0,0 if that support is missing.

            The buttons paint above the SVG, so the head tucks BEHIND each node
            as it arrives rather than covering its number. */}
        <div class="hiw-side">
          <div class="hiw-arc">
            <svg
              class="hiw-arc-svg"
              viewBox={`0 0 ${ARC.w} ${ARC.h}`}
              preserveAspectRatio="none"
              fill="none"
              aria-hidden="true"
            >
              <path class="hiw-arc-bleed" d={arcBleedPath} />
              <path class="hiw-arc-track" d={arcStepPath} pathLength="1" />
              <path class="hiw-arc-fill" d={arcStepPath} pathLength="1" />
              <path class="hiw-arc-head" d={arcStepPath} pathLength="1" />
            </svg>

            <div role="tablist" aria-label="Deployment steps" class="hiw-rail">
              {arcNodes.map((d, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`hiw-tab-${i}`}
                  aria-controls={`hiw-panel-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  class="hiw-node"
                  style={`--hiw-x: ${d.xPct.toFixed(3)}%; --hiw-y: ${d.yPct.toFixed(3)}%; --hiw-at: ${d.at.toFixed(4)};`}
                >
                  <span class="hiw-node-circle mono">{d.n}</span>
                  <span class="hiw-node-title">{d.title}</span>
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="hiw-main">
          <div class="hiw-panels">
            {deployment.map((d, i) => (
              <div role="tabpanel" id={`hiw-panel-${i}`} aria-labelledby={`hiw-tab-${i}`} tabindex="0" class="hiw-panel">
                <p class="t-cap mono" style="color: var(--color-muted);">{d.n}</p>
                <h3 class="t-h3 mt-2">{d.title}</h3>
                <p class="t-body mt-3">{d.body}</p>
              </div>
            ))}
          </div>

          <p class="t-sm mt-9 prose" style="color: var(--color-muted);">{deploymentCaveat}</p>
        </div>
      </div>
    </div>
        </div>
      </div>
    </div>
  </section>

  {/* ══════════════ WHY ══════════════
      Ported verbatim from the supplied reference comp — eyebrow, two-line
      headline with one highlighted phrase, short subline, four icon cards,
      closing compliance bar. Not run through DESIGN.md's radius/centering
      rules on purpose; this section matches the reference pixel-for-pixel
      instead. */}
  <section class="section why-section">
    <div class="shell">
      {/* Heading left, lede right. It was one narrow column: the h2 capped at
          18ch inside a 1104px shell, so "work." orphaned onto a third line and
          the right two-thirds of the row sat empty. */}
      <div class="why-head">
        <div>
          <p class="t-label why-eyebrow">Why institutions choose AI Nexus</p>
          <h2 class="why-heading">
            One platform per industry.<br />
            AI that <span class="why-heading__accent">shows its work.</span>
          </h2>
        </div>
        <p class="t-sm why-lede">
          Integrated. Verifiable. Built for India.<br />
          So your team can focus on what matters.
        </p>
      </div>

      <div class="why-grid">
        {why.map((w) => (
          <div class="why-card">
            <div class="why-card__head">
              <span class="why-card__icon"><Icon name={w.icon} size={20} /></span>
              <h3 class="why-card__title">{w.title}</h3>
            </div>

            <div class="why-card__rule"></div>

            <div class="why-card__stat-block">
              <p class="why-card__stat mono">{w.stat}</p>
              <p class="why-card__unit">{w.unit}</p>
            </div>

            <div class="why-card__rule"></div>

            <p class="why-card__caption">
              <Icon name="check" size={13} />
              <span>{w.caption}</span>
            </p>
          </div>
        ))}
      </div>

      <div class="why-bar">
        <Icon name="shield" size={15} />
        <span>Every output is verifiable. Every action is logged. Every control is enforced.</span>
      </div>
    </div>
  </section>

  {/* ══════════════ ROLE FAMILIES ══════════════
      Heading above, four wide cards in a 2×2 below, so the whole section
      fits one screen. Each card runs horizontally — count on the left,
      copy on the right — which is what keeps it short: at ~570px wide the
      body sits on two lines instead of five.

      The count used to render twice per card (once as the display figure,
      once as a meta line underneath); it is stated once now. */}
  <section class="section band">
    <div class="shell">
      <h2 class="t-h2" style="max-width: 20ch;">Built for every seat</h2>
      <p class="t-lede mt-4" style="max-width: 62ch;">
        A doctor, a teacher, an intern and a property owner need different things from the same
        platform. Each product ships role-specific views, and the audit log records who saw what.
      </p>

      <div class="seat-grid mt-10">
        {roleFamilies.map((r, idx) => {
          const [countPart, platformName = ''] = r.meta.split('·').map((s) => s.trim());
          const [num, ...unitWords] = countPart.split(' ');
          /* Held-back solution pages: the card keeps its content but stops
             being a link, so it cannot promise a page the nav marks
             "Coming soon". Astro needs a concrete tag, hence the switch. */
          const Tag = isPlanned(r.href) ? 'div' : 'a';
          return (
            <Tag
              {...(isPlanned(r.href) ? {} : { href: r.href })}
              class="glow-card seat-card no-underline"
              style={`--glow-color: color-mix(in oklab, ${r.hue} 55%, transparent);`}
              data-glow-card
            >
              <span
                class="glow-card-texture"
                aria-hidden="true"
                style={`background-image: repeating-linear-gradient(${roleAngles[idx]}deg, color-mix(in oklab, ${r.hue} 10%, transparent), color-mix(in oklab, ${r.hue} 10%, transparent) 10px, transparent 10px, transparent 22px);`}
              />
              <div class="glow-card-inner seat-card__inner">
                <div class="seat-card__lead">
                  <span class="glow-card-icon" style={`color: ${r.hue};`} aria-hidden="true">
                    <Icon name={roleIcons[idx]} size={18} />
                  </span>
                  <span class="seat-card__num mono">{num}</span>
                  <span class="seat-card__unit t-cap">{unitWords.join(' ')}</span>
                </div>

                <div class="seat-card__main">
                  <h3 class="t-h4">{r.title}</h3>
                  <p class="t-sm mt-1.5" style="color: var(--color-muted);">{r.body}</p>
                  <span class="seat-card__foot mt-3">
                    <span class="t-cap mono" style="color: var(--color-muted);">{platformName}</span>
                    {isPlanned(r.href) ? (
                      <span class="soon">Coming soon</span>
                    ) : (
                      <span class="link-accent">
                        Explore <Icon name="arrow-right" class="arrow" size={14} />
                      </span>
                    )}
                  </span>
                </div>
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>

  {/* ══════════════ FAQ — native <details>, zero JS ══════════════
      Two columns: a sticky rail carrying the heading and a direct-contact
      card, and the accordion itself. The rail collapses above the accordion
      on narrow viewports. Native <details> keeps every answer in the DOM and
      keyboard-operable with no client script. */}
  <section class="section">
    <div class="shell grid gap-x-16 gap-y-10 lg:grid-cols-[5fr_7fr] lg:items-start">
      <div class="faq-rail flex flex-col gap-5">
        <p class="t-label" style="color: var(--color-accent);">Answers</p>
        <h2 class="t-h2" style="max-width: 14ch;">Frequently asked questions</h2>
        <p class="t-sm" style="color: var(--color-muted); max-width: 42ch;">
          The things institutions ask us first: on data residency, the agents, pricing and how a
          deployment actually runs.
        </p>

        <div class="card p-6 flex flex-col gap-3 mt-2">
          <h3 class="t-h4">Still have a question?</h3>
          <p class="t-sm" style="color: var(--color-body);">
            Ask us directly: we reply within one business day.
          </p>
          <div class="flex flex-wrap gap-3 mt-1">
            <a href="/contact/" class="btn btn-primary tx-fast">
              Book a demo <Icon name="arrow-right" class="arrow" />
            </a>
            <a href={`mailto:${contact.email}`} class="btn btn-secondary tx-fast">
              <Icon name="mail" size={15} /> Email us
            </a>
          </div>
        </div>
      </div>

      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <span class="faq-toggle">
                <Icon name="plus" class="chev" size={16} />
              </span>
            </summary>
            <p class="answer t-body">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ══════════════ CTA ══════════════
      Copy on the left, a phone showing a platform actually running on the
      right — the heading says "see a platform in action", so the device
      shows exactly that.

      What is on the screen is MedOrbit's own agent day from
      platforms.ts, carrying its own "illustrative" note. No invented
      dashboard figures: this page states elsewhere that it declines to
      quote numbers it has not measured, so a mock-up full of fake revenue
      would contradict the product's whole argument. */}
  <section class="section cta-live">
    <div class="shell">
      <div class="cta-live__grid">
        <div class="cta-live__copy">
          <h2 class="t-h2">
            See a platform <span style="color: var(--color-accent);">in action</span>.
          </h2>
          <p class="t-lede mt-5">
            A 30-minute demo of any platform, run on your own facility type, board, practice area or
            city, or a conversation about partnership. We reply within one business day.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/contact/" class="btn btn-primary tx-fast">
              Book a demo <Icon name="arrow-right" class="arrow" />
            </a>
            <a href={contact.linkedin} target="_blank" rel="noopener" class="btn btn-secondary tx-fast">
              Connect on LinkedIn <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
        </div>

        {/* Decorative: everything in here is stated in prose elsewhere on the
            page, so a screen reader is not made to walk a fake UI. */}
        <div class="cta-live__device" aria-hidden="true">
          <div class="phone">
            <span class="phone__notch"></span>
            <div class="phone__screen">
              <div class="phone__head">
                <img src={`/platforms/${ctaPlatform.slug}.png`} alt="" class="phone__logo" />
                <span class="t-cap" style="color: var(--color-muted);">{ctaPlatform.sector}</span>
              </div>

              <div class="phone__stats">
                <div class="phone__stat">
                  <span class="phone__stat-fig mono">{ctaPlatform.agentCount}</span>
                  <span class="phone__stat-lab">AI agents</span>
                </div>
                <div class="phone__stat">
                  <span class="phone__stat-fig mono">{ctaPlatform.stats[2].figure}</span>
                  <span class="phone__stat-lab">{ctaPlatform.stats[2].label}</span>
                </div>
              </div>

              <p class="phone__title t-cap">{ctaPlatform.panel.title}</p>
              <ul class="phone__rows list-none m-0 p-0">
                {ctaPlatform.panel.rows.map((r) => (
                  <li class="phone__row">
                    <span class="phone__when mono">{r.when}</span>
                    <span class="phone__what">{r.what}</span>
                    <span class="phone__out">{r.outcome}</span>
                  </li>
                ))}
              </ul>
              <p class="phone__note">{ctaPlatform.panel.note}</p>
            </div>
            <span class="phone__bar"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>

<script>
  import { initReveal } from '../scripts/reveal.js';
  import { initGlowCards } from '../scripts/glow-cards.js';
  import { initTabs } from '../scripts/tabs.js';
  import { initStepScroll } from '../scripts/step-scroll.js';
  initReveal();
  initGlowCards();

  const deploymentTabs = document.getElementById('deployment-tabs');
  if (deploymentTabs) {
    const api = initTabs(deploymentTabs);
    initStepScroll(deploymentTabs.closest('.hiw-track'), api);
  }
</script>
