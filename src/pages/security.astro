---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Reveal from '../components/ui/Reveal.astro';
import RevealRoot from '../components/ui/RevealRoot.astro';
import { platforms } from '../content/platforms';
import { detail } from '../content/platform-detail';
import { governance } from '../content/home';
import { securityFaqs } from '../content/pages';
import { contact } from '../content/site';

/* Hero verification row — one representative compliance line per platform,
   pulled straight from the same data the Standards section renders below.
   No new copy: this is an echo of §Standards, not a new claim. */
const heroChips = platforms.map((p) => detail[p.slug].compliance[0]);
---

<Base
  title="AI Governance, DPDP Compliance & Data Residency | AI Nexus"
  description="The controls implemented in all four AI Nexus platforms: PHI redaction, citation verification, fail-closed consent, human approval, cost ceilings, per-agent kill switches and append-only audit trails. Data in AWS Mumbai."
>
  <RevealRoot />

  {/* ── Hero ──
      Contained card on the branded surface, same construction as /about/ and
      /platforms/ so the three read as one system. The right column is a
      ledger of figures that already appear on this page — 8 controls below,
      48 agents across the four platforms, the AWS Mumbai region — so the
      hero summarises the page rather than making a new claim. */}
  <section class="section sec-hero-section">
    <div class="shell">
      <Breadcrumbs trail={[{ href: '/', label: 'Home' }, { label: 'Security' }]} />

      <div class="sec-hero mt-5">
        <div class="sec-hero__copy">
          <p class="t-label rise sec-hero__eyebrow" style="--i: 0;">Governance &amp; data residency</p>
          <h1 class="t-h1 rise mt-4" style="--i: 1; max-width: 16ch;">How the AI is governed</h1>
          <p class="t-lede rise mt-6" style="--i: 2;">
            The same discipline runs through all four platforms. Everything on this page is a control
            implemented in the software, not a commitment in a policy document.
          </p>

          <ul class="sec-hero__chips rise mt-8 list-none m-0 p-0" style="--i: 3;">
            {
              heroChips.map((c, i) => (
                <li class="pill chip-verify sec-chip" style={`--i: ${i};`}>
                  <Icon name="check" size={13} class="sec-chip__tick" />
                  <span>{c}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <dl class="sec-hero__ledger rise" style="--i: 4;">
          {
            [
              { figure: '8', label: 'controls implemented in software' },
              { figure: '48', label: 'AI agents, all governed the same way' },
              { figure: '4', label: 'platforms, one discipline' },
              { figure: 'ap-south-1', label: 'AWS Mumbai — data stays in India' },
            ].map((row) => (
              <div class="sec-ledger-row">
                <dt class="sec-ledger-figure mono">{row.figure}</dt>
                <dd class="sec-ledger-label t-cap m-0">{row.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* ── The controls ── */}
  <section class="section band">
    <div class="shell">
      <Reveal>
        <h2 class="t-h2">The controls</h2>
      </Reveal>
      <div class="mt-12 grid gap-x-9 gap-y-10 sm:grid-cols-2 xl:grid-cols-4">
        {
          governance.map((g, i) => (
            <Reveal i={i} as="div" class="ctrl flex flex-col gap-2.5 pt-5" style={`--i: ${i};`}>
              <span class="ctrl-check" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <circle cx="10" cy="10" r="9" stroke="var(--color-hairline)" stroke-width="1.5" />
                  <path
                    class="ctrl-check-mark"
                    d="M5.5 10.3 8.5 13.3 14.5 6.8"
                    stroke="var(--color-verified)"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                    pathLength="1"
                  />
                </svg>
              </span>
              <h3 class="t-h4">{g.title}</h3>
              <p class="t-sm">{g.body}</p>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Data residency. The second and last Ink block on this page. ── */}
  <section class="section">
    <div class="shell">
      <div class="residency-panel rounded-[16px] p-8 sm:p-10" style="background: var(--color-ink);">
        <h2 class="t-h2" style="color: #fff;">Data residency</h2>
        <p class="t-lede mt-5" style="color: #a8b4c8;">
          All four platforms run in AWS Mumbai
          <span class="mono residency-tag" style="color: #fff;">(ap-south-1)</span>.
          Data does not leave India in normal operation.
        </p>
        <div class="seal-rule residency-seal mt-9 h-px w-full" style="background: var(--color-accent);"></div>
      </div>
    </div>
  </section>

  {/* ── Per-platform standards ── */}
  <section class="section band">
    <div class="shell">
      <Reveal>
        <h2 class="t-h2" style="max-width: 22ch;">Standards each platform implements</h2>
      </Reveal>
      <Reveal i={1}>
        <p class="t-lede mt-5">
          These are capability statements, not certification logos. We publish certificates only when they
          exist.
        </p>
      </Reveal>

      <div class="mt-12 grid gap-8 sm:grid-cols-2">
        {
          platforms.map((p, i) => (
            <Reveal i={i} as="div">
              <div class="card hov p-6 flex flex-col gap-4" style={`border-top: 3px solid ${p.hue};`}>
                <div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-2">
                  <h3 class="t-h3">{p.name}</h3>
                  <a href={`/platforms/${p.slug}/`} class="link-accent group/link">
                    Platform details <Icon name="arrow-right" class="arrow" size={14} />
                  </a>
                </div>
                <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
                  {detail[p.slug].compliance.map((c, pi) => (
                    <li
                      class="pill pill-tick"
                      style={`--pi: ${pi}; background: var(--color-mist); border: 1px solid var(--color-hairline); color: var(--color-body);`}
                    >
                      {c}
                    </li>
                  ))}
                </ul>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section class="section">
    <div class="shell">
      <Reveal>
        <h2 class="t-h2" style="max-width: 20ch;">Questions we get asked</h2>
      </Reveal>
      <div class="mt-10">
        <Faq items={securityFaqs} openFirst />
      </div>

      <p class="t-sm mt-9">
        Security questions:
        <a href={`mailto:${contact.email}`} class="mono" style="color: var(--color-accent);">{contact.email}</a>
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  import { initReveal } from '../scripts/reveal.js';
  initReveal();
</script>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────────
     Load entrance, 60ms per step. Self-completing: if it never runs the page
     is already correct (matches /about/ and /platforms/ .rise). */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .rise {
    animation: rise var(--dur-element) var(--ease-entrance) both;
    animation-delay: calc(var(--i, 0) * var(--reveal-stagger));
  }

  .sec-hero-section {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) 0;
  }

  /* Branded surface, same construction as .about-hero — accent-wash pooling
     from the lower-left over the Wash neutral. Existing tokens only. */
  .sec-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: clamp(16px, 2.2vw, 28px);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.75rem, 5vw, 4rem);
    background:
      radial-gradient(120% 130% at 0% 100%, var(--color-accent-wash) 0%, transparent 58%),
      var(--color-wash);
    border: 1px solid var(--color-hairline);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  /* Fine vertical streak texture, masked so it never reads as a grid. */
  .sec-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: repeating-linear-gradient(
      90deg,
      rgb(43 70 212 / 0.05) 0 1px,
      transparent 1px clamp(52px, 6vw, 82px)
    );
    mask-image: linear-gradient(180deg, transparent 0%, #000 45%, #000 100%);
  }

  .sec-hero__eyebrow {
    color: var(--color-muted);
  }

  .sec-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  /* The chips are verified controls, not tags — the tick says so at rest,
     and `.chip-verify` only delays its arrival. */
  .sec-chip {
    gap: 0.4rem;
    font-family: var(--font-mono);
    background: var(--color-paper);
  }
  .sec-chip__tick {
    color: var(--color-verified);
    flex: none;
  }

  /* Right column: figures that already appear further down the page. */
  .sec-hero__ledger {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .sec-ledger-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--color-hairline);
  }
  .sec-ledger-row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .sec-ledger-figure {
    flex: none;
    min-width: 4.5ch;
    font-size: var(--text-h3);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--color-ink);
  }
  /* 'ap-south-1' is a region string, not a count — it must not render at the
     same display size or it overflows the column. */
  .sec-ledger-row:last-child .sec-ledger-figure {
    font-size: var(--text-body-sm);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .sec-ledger-label {
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .sec-hero {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: center;
    }
    .sec-hero__ledger {
      border-left: 1px solid var(--color-hairline);
      padding-left: clamp(2rem, 4vw, 3rem);
    }
  }

  /* ── Controls grid ────────────────────────────────────────────────────── */
  .ctrl {
    border-top: 1px solid var(--color-hairline);
  }
  .ctrl-check {
    display: inline-flex;
  }
  /* Base state: the check is fully drawn, so a no-JS / no-scroll reader sees
     a complete, correct badge — the stroke draw is a delay on arrival, not a
     reveal of content. */
  .ctrl-check-mark {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  html[data-reveal-ready] [data-reveal] .ctrl-check-mark {
    stroke-dashoffset: 1;
  }
  html[data-reveal-ready] [data-reveal][data-revealed] .ctrl-check-mark {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset var(--dur-section) var(--ease-entrance) calc(var(--dur-element) * 0.4);
  }

  /* ── Data residency panel ─────────────────────────────────────────────── */
  .residency-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  /* Same streaked-light texture as the home hero card, retinted for the ink
     surface — white hairlines instead of the accent gradient beneath them. */
  .residency-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: repeating-linear-gradient(
      90deg,
      rgb(255 255 255 / 0.05) 0 1px,
      transparent 1px clamp(52px, 6vw, 82px)
    );
    mask-image: linear-gradient(180deg, transparent 0%, #000 45%, #000 100%);
  }
  .residency-tag {
    border-radius: 4px;
    padding: 0.05em 0.35em;
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-verified) 55%, transparent);
  }
  .residency-seal {
    transform-origin: left center;
  }

  /* ── Standards cascade ────────────────────────────────────────────────── */
  .pill-tick {
    animation: tick-verified var(--dur-element) var(--ease-entrance) both paused;
    animation-delay: calc(var(--pi, 0) * 90ms);
  }
  html[data-reveal-ready] [data-reveal][data-revealed] .pill-tick {
    animation-play-state: running;
  }
</style>
